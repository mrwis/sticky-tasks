    def _on_review_wheel(self, e):
        """复盘面板自己的滚轮。主窗口也挂了 bind_all 的滚轮，
        所以 _on_wheel 那边要认得这是别人的事件、别乱动主画布。"""
        try:
            self._review_cv.yview_scroll(-1 if e.delta > 0 else 1, "units")
        except Exception:
