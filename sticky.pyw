def today():
    return datetime.date.today()


def d2s(d):
    return d.strftime("%Y-%m-%d")


def parse_dt(s):
    """把存盘里的日期字符串解析成 datetime。认两种形态：

      · "2026-10-15"             —— 只有日期（老数据、以及"天"粒度的截止）
      · "2026-10-15 18:30:05"    —— 带时分秒（用户在「＋ 日期」里填了时刻）
    少写秒的 "2026-10-15 18:30" 也认。认不出返回 None。

    **为什么还留着只给日期的 s2d()**：全项目几十处拿它的结果跟 date 比
    （今天要做 / 已逾期 / 热力图 / 重复任务）。让它继续只返回"哪一天"，
    这些地方一个都不用动；要看具体时刻的走 due_point()。两套并存，
    改动面最小 —— 这是这次改日期精度能不影响别处的前提。
    """
    txt = str(s or "").strip()
    if not txt:
        return None
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return datetime.datetime.strptime(txt, fmt)
        except Exception:
            pass
    return None


def due_has_time(s):
    """这个日期串带不带具体时刻。

    判据就是"有没有冒号" —— 比 parse 之后再比时分秒稳：用户真填了
    "18:00" 就该按时刻算，哪怕它正好是整点。
    """
    return ":" in str(s or "")


def norm_due(s):
    """归一成存盘格式：带时刻的 "YYYY-MM-DD HH:MM:SS"，只有日期的 "YYYY-MM-DD"。
    认不出返回 ""。**日期串在库里只有这一种形状**，别在别处自己拼。"""
    dt = parse_dt(s)
    if not dt:
        return ""
    if due_has_time(s):
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    return dt.strftime("%Y-%m-%d")


def s2d(s):
    dt = parse_dt(s)
    return dt.date() if dt else None


def fmt_ts(ts, ref=None):
    """时间戳 → 卡面上那行小字：'10-15 14:23:05'（不是今年就带两位年）。

    ts<=0 表示判不出来（老数据没有 created_at，order 又不像时间戳），
    返回 "" —— 调用方据此决定不画。
    """
    try:
        ts = float(ts)
    except (TypeError, ValueError):
        return ""
    if ts <= 0:
        return ""
    ref = ref or today()
    try:
        d = datetime.datetime.fromtimestamp(ts)
    except Exception:
        return ""
    if d.year != ref.year:
        return d.strftime("%y-%m-%d %H:%M:%S")
    return d.strftime("%m-%d %H:%M:%S")


def due_point(s):
    """截止"时刻"：带时间的按那个时间点；只有日期的按当天 23:59:59（整天都算没到期）。

    这样"是否逾期"只有一种判法（now > due_point），不用到处写两个分支。
    """
    dt = parse_dt(s)
    if not dt:
        return None
    if not due_has_time(s):
        dt = dt.replace(hour=23, minute=59, second=59, microsecond=0)
    return dt


def is_overdue(t):
    """这条任务是不是已经逾期了。

    · 带时刻的：过了那个时间点就算逾期（今天 09:00 的活，15:00 就该红）
    · 只有日期的：过了那一整天（跟以前一样，今天到期的不算逾期）
    """
    if t.get("done") or not t.get("due"):
        return False
    p = due_point(t["due"])
    return bool(p and datetime.datetime.now() > p)


def remind_key_for(t):
    """这条任务这次提醒该记的 key。

    整天的按天（每天只弹一次）；带时刻的按那个时刻串（那次到点只弹一次）——
    不然今天 09:00 的活提醒过之后，18:00 的那条就再也不弹了。
    """
    if due_has_time(t.get("due")):
        return norm_due(t.get("due"))
    return d2s(today())


def due_label(s):
    """给人看的日期串（菜单/提示里用）：带时刻的连时刻一起写，整点的省掉秒。"""
    dt = parse_dt(s)
    if not dt:
        return ""
    if not due_has_time(s):
        return dt.strftime("%Y-%m-%d")
    if dt.second:
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    return dt.strftime("%Y-%m-%d %H:%M")


def new_id():
    return "t%d%04d" % (int(datetime.datetime.now().timestamp() * 1000) % 100000000,
                        int.from_bytes(os.urandom(2), "big") % 10000)


def new_sid():
    """子任务 id（单独一个前缀，便于在数据里一眼区分）。"""
    return "s" + new_id()[1:]


# ---------------------------------------------------------------- 小工具函数

def now_ts():
    return datetime.datetime.now().timestamp()


def ts_day(ts):
    """某个时间戳属于哪一天。计时跨过午夜时，整段时长算在「开始那天」。"""
    try:
        return d2s(datetime.datetime.fromtimestamp(ts).date())
    except Exception:
        return d2s(today())


def screen_areas(widget):
    """widget 所在那块显示器的矩形 → ((整屏), (工作区))，都是 (left, top, right, bottom)。

    **为什么不能直接用 winfo_screenwidth/height**：那报的是**主屏**尺寸。
    主窗拖到副屏后，拿主屏宽度给弹出窗做「别超出屏幕」的收边，会算出"超出屏幕了"
    而把窗口一把拽回主屏 —— 表现就是「帮助 / 复盘没跟着软件走，跑到另一块屏上去」。
    实测：主窗在副屏 (2137,145)，winfo_screenwidth() 仍然给 1920。

    所以这里问 Win32：MonitorFromWindow 拿 widget 当前所在的那块显示器，
    GetMonitorInfoW 取它的 rcMonitor（整屏）和 rcWork（工作区，已排除任务栏）。
    flag 用 _MONITOR_DEFAULTTONEAREST(2)：窗口正好卡在两屏之间时也给最近的一块。

    非 Windows（没有 ctypes.windll）或调用失败时，退回主屏尺寸 —— 也就是从前的行为，
    单屏环境两者本来就一样。
    """
    try:
        import ctypes
        from ctypes import wintypes

        class RECT(ctypes.Structure):
            _fields_ = [("left", wintypes.LONG), ("top", wintypes.LONG),
                        ("right", wintypes.LONG), ("bottom", wintypes.LONG)]

        class MONITORINFO(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", RECT),
                        ("rcWork", RECT), ("dwFlags", wintypes.DWORD)]

        u = ctypes.windll.user32
        u.MonitorFromWindow.argtypes = [wintypes.HWND, wintypes.DWORD]
        u.MonitorFromWindow.restype = ctypes.c_void_p
        u.GetMonitorInfoW.argtypes = [ctypes.c_void_p,
                                      ctypes.POINTER(MONITORINFO)]
        u.GetMonitorInfoW.restype = wintypes.BOOL

        hm = u.MonitorFromWindow(wintypes.HWND(widget.winfo_id()), 2)
        mi = MONITORINFO()
        mi.cbSize = ctypes.sizeof(MONITORINFO)
        if hm and u.GetMonitorInfoW(hm, ctypes.byref(mi)):
            m, k = mi.rcMonitor, mi.rcWork
            return ((m.left, m.top, m.right, m.bottom),
                    (k.left, k.top, k.right, k.bottom))
    except Exception:
        pass

    box = (0, 0, widget.winfo_screenwidth(), widget.winfo_screenheight())
    return (box, box)


def fmt_dur(sec):
    """秒 → 紧凑时长文本：45秒 / 12分 / 1时05分"""
    sec = int(max(0, sec or 0))
    if sec < 60:
        return "%d秒" % sec
    m = sec // 60
    if m < 60:
        return "%d分" % m
    h, m2 = divmod(m, 60)
    return "%d时%02d分" % (h, m2)


def ellipsis(s, n):
    """超长文本截断加省略号（按字符数算，中英文都按一个字符，够用了）。"""
    s = str(s)
    return s if len(s) <= n else s[:max(1, n - 1)] + "…"


def spent_of(t, now=None):
    """这个任务一共花了多少秒 = 已记录的流水 + 正在计时的那一段。"""
    s = 0.0
    for v in (t.get("logs") or {}).values():
        try:
            s += float(v or 0)
        except (TypeError, ValueError):
            pass
    st = t.get("timer") or 0
    if st:
        s += max(0.0, (now or now_ts()) - st)
    return s


def subs_of(t):
    """任务的子任务列表。

    注意：**必须返回任务里那个列表本身**，不能返回一个新造的空表。
    以前写成 `t.get("subs") or []` —— 子任务为空时 `or` 会把右边那个
    临时空表返回出去，于是"往没有子任务的任务里加一条子任务"就加进了
    一个没人认领的临时表里，看起来什么都没发生（拖别的子任务过去时会
    直接把它弄丢）。列表为空也要原样返回。
    """
    s = t.get("subs")
    if not isinstance(s, list):
        s = []
        t["subs"] = s
    return s


def sub_done_n(t):
    return len([s for s in subs_of(t) if s.get("done")])


# 哪些卡片把"收起的已完成子任务"临时摊开了（存任务 id）。
#
# 放模块级的唯一原因还是 block_h()：它是纯函数、拿不到 App 实例，而
# **算高度和画卡片必须用同一个判断**（见机制⑪/⑭，SHOW_TIME 也是这个道理）。
# 只活在内存里、不落库 —— 重开程序回到"收起"，因为收起才是常态下想看的。
SUB_SHOW_DONE = set()


def sub_done_day(s):
    """子任务是在哪一天完成的。

    老数据（或子任务刚被取消完成）没有 done_at → 返回 ""，按"早就完成了"
    处理，也就是直接收起。跟主任务的 done_day() 不同，这里**没有第二层兜底**：
    子任务结构里既没有 order 也没有别的能当时间用的字段。
    """
    if not s.get("done"):
        return ""
    ts = _norm_num(s.get("done_at"))
    return ts_day(ts) if ts > TS_OK else ""


def visible_subs(t):
    """卡片上真正要画的那些子任务：**未完成的在前、已完成的沉底**，
    而且已完成里"不是今天完成的"直接不画（跟主任务板面那套规则对称）。

    为什么这么排：一个任务的子任务多了以后，用户要的是"一眼看见还没做的"，
    而不是在一堆划掉的行里扒拉。当天划掉的那几条仍然留着（有反馈感，
    也方便手滑点错时点回来），第二天自动收起。

    收起的那部分不是没了 —— 卡片上会写「已完成 N」并给一个能点开的胶囊，
    点开就临时摊平（`App.toggle_sub_done_view`，状态存在 SUB_SHOW_DONE 里）。

    **排序只发生在显示层**：数据里的 order 是用户一条条拖出来的，不能动 ——
    否则取消完成之后它自己会跑到别的地方去。
    """
    subs = subs_of(t)
    if t.get("id") not in SUB_SHOW_DONE:
        T = d2s(today())
        subs = [s for s in subs
                if not (s.get("done") and sub_done_day(s) != T)]
    return ([s for s in subs if not s.get("done")]
            + [s for s in subs if s.get("done")])


def hidden_sub_n(t):
    """卡片上没画出来的子任务条数（已收起的那部分）。"""
    return len(subs_of(t)) - len(visible_subs(t))


def sub_pages(n):
    """n 条子任务要分几页（每页 SUB_MAX 条）。**至少一页** ——
    没子任务时也返回 1，省得调用方到处写 `or 1`。"""
    return max(1, -(-int(n) // SUB_MAX))


def sub_by_id(t, sid):
    for s in subs_of(t):
        if s.get("id") == sid:
            return s
    return None


_FONTS = {}


def _font_of(font):
    """按字体规格取一个缓存的 tkfont.Font。

    折行要不停 measure()，每次新建 Font 太浪费；而且 block_h() 在每次重绘
    时都会被调很多遍。按规格缓存一份就够。
    """
    key = tuple(font) if isinstance(font, (list, tuple)) else font
    f = _FONTS.get(key)
    if f is None:
        f = tkfont.Font(font=font)
        _FONTS[key] = f
    return f


def _wrap_lines(text, font, maxw, maxlines):
    """按像素宽度折行，返回折好的行列表。

    **全项目只有这一份折行规则**：App._wrap（画的时候用）和 block_h（算高度
    用）都调它。以前高度是写死的，所以折行只影响画面；现在高度靠行数算，
    两处规则一旦不一致，卡片就会算矮、互相压住 —— 所以千万别在别处再抄一份。
    英文/数字当成一个整体，避免把 NAS 拆成 N / AS。
    """
    f = _font_of(font)
    tokens = re.findall(r"[A-Za-z0-9][A-Za-z0-9\-_.]*|[ \t]+|\r|\n|.", str(text))
    lines, cur = [], ""
    for tk_ in tokens:
        if tk_ == "\r":               # 容错：\r\n 里的 \r 直接丢掉
            continue
        if tk_ == "\n":
            lines.append(cur)
            cur = ""
            if len(lines) > maxlines:
                break
            continue
        cand = cur + tk_
        if f.measure(cand) > maxw and cur:
            lines.append(cur)
            cur = tk_.lstrip() if tk_.strip() else ""
        else:
            cur = cand
        if len(lines) > maxlines:
            break
    if cur and len(lines) <= maxlines:
        lines.append(cur)
    if len(lines) > maxlines:
        lines = lines[:maxlines]
        last = lines[-1]
        while last and f.measure(last + "…") > maxw:
            last = last[:-1]
        lines[-1] = last + "…"
    return lines


def _text_w(t):
    """卡面上标题/备注能用的文字宽度。

    必须和 _draw_card 里 tw 的算法一致，否则按这里算出来的行数会和实际
    画出来的对不上（卡片就压住了）。左边这一串是：复选框左缘 + 复选框边长
    + 与文字的间距；标题前面挂重复徽章时还要再让出徽章 + 间距。
    """
    left = 13 + 15 + 10
    if t.get("repeat"):
        left += 18 + 6
    return CARD_W - 13 - left


def _title_w(t):
    """卡面上**标题**能用的宽度：比 _text_w 再让出右端那行时间的宽度。

    「创建 / 完成时间」跟标题同一行（用户要求的"不要多占一行"），所以折行
    必须按这个宽度算 —— `block_h()` 和 `_draw_card()` 都要用它，否则算出来
    的行数和画出来的对不上（见机制⑪）。

    没有时间可显示时（关掉了显示 / 判不出创建时间）就是 _text_w 本身，
    标题拿回全部宽度。
    """
    w = _text_w(t)
    m = meta_line(t)
    if m:
        w -= _font_of(F_SMALL).measure(m) + META_INLINE_GAP
    return w


def note_lines(t):
    """备注占几行。**空备注也算一行** —— 那行画的是「＋ 备注」入口。"""
    if not t.get("note"):
        return 1
    return len(_wrap_lines(t["note"], F_BODY, _text_w(t), 2)) or 1


def block_h(t):
    """卡片高度 = 内容实高 + 呼吸位 + 底部徽章行。

    以前是「固定 CARD_H + 子任务增量」：标题、备注只有一两行时，卡片下半截
    全是空白，既不好看又白占地方（见机制⑪）。改成按内容实算。

    **布局和绘制必须都调这个函数**，而且在没有 Tk 环境时也要能算
    （_selftest 会这么用），所以它只依赖折行测量，不碰任何控件。
    下面的偏移量和 _draw_card 里的坐标是一对，改一边必须改另一边。
    """
    nth = len(_wrap_lines(t.get("title", ""), F_TITLE, _title_w(t), 2))
    note_top = TITLE_TOP + LINE_TITLE * nth + NOTE_GAP
    note_bottom = note_top + LINE_NOTE * note_lines(t)

    n_all = len(subs_of(t))
    if n_all:
        # 子任务区一律从**备注底**往下排（备注为空时那行「＋ 备注」也算一行，
        # 见 note_lines）—— 这样空备注的卡片不会把「子任务 x/y」压到那行字上。
        #
        # 几行按**可见条数**算：已完成的第二天收起，卡片跟着变矮。
        # 可见条数可能是 0（全收起了）—— 这时仍然留着标题行（上面那个
        # 「已完成 N」的胶囊是唯一能摊开它们的入口），只是不占子任务行的高度。
        sub_top = note_bottom + SUB_PAD
        nv = min(len(visible_subs(t)), SUB_MAX)
        content = sub_top + SUB_PAD + SUB_HEAD + SUB_LINE * nv
    else:
        content = note_bottom
    # 「创建 / 完成时间」那一行跟标题并排，**不额外占高度**（用户要的），
    # 所以这里没有任何 meta 相关的高度计算 —— 只影响标题的折行宽度（_title_w）。
    return max(CARD_H, content + FOOT_GAP + FOOT_H)


def row_heights(items, ncol):
    """把卡片按 ncol 列切成若干行，返回每行的高度（取该行最高的一张）。"""
    hs = []
    for i in range(0, len(items), ncol):
        hs.append(max(block_h(t) for t in items[i:i + ncol]))
    return hs or [CARD_H]


def _norm_num(v):
    """把来路不明的值安全地变成浮点数（旧数据/手改 JSON 都不怕）。"""
    try:
        return float(v or 0) or 0.0
    except (TypeError, ValueError):
        return 0.0


def _norm_subs(raw):
    """把 subs 归一成 [{"id","text","done","done_at"}]，顺带容忍「纯字符串列表」这种简写。

    done_at 是**子任务的完成时间戳**：卡片上"已完成次日收起"靠它判断。
    老数据没有这个字段，读出来是 0 → sub_done_day() 会当成"早就完成了"
    （也就是直接收起），这个取舍是有意的。
    """
    out = []
    if isinstance(raw, list):
        for s in raw:
            if isinstance(s, dict):
                txt = str(s.get("text", "")).strip()
                if txt:
                    done = bool(s.get("done"))
                    out.append({"id": s.get("id") or new_sid(),
                                "text": txt, "done": done,
                                # 没完成就不该留着完成时间（取消完成要清干净）
                                "done_at": _norm_num(s.get("done_at")) if done else 0.0})
            elif isinstance(s, str) and s.strip():
                out.append({"id": new_sid(), "text": s.strip(), "done": False,
                            "done_at": 0.0})
    return out


def _norm_logs(raw):
    """把 logs 归一成 {"YYYY-MM-DD": 秒}，非法键值直接丢掉。"""
    out = {}
    if isinstance(raw, dict):
        for k, v in raw.items():
            d = s2d(str(k))
            sec = _norm_num(v)
            if d and sec > 0:
                key = d2s(d)
                out[key] = out.get(key, 0.0) + sec
    return out


def _norm_p(p):
    """p 的合法范围**跟着象限数量走**（象限可增删，不能再写死 0~3）。

    超出范围的（老数据、手改过 json、删过格子）一律收到最后一格 ——
    宁可归错一格，也不能让任务在板面上消失。
    """
    try:
        p = int(p)
    except (TypeError, ValueError):
        p = 2
    n = max(1, len(PRIOS))
    return p if 0 <= p < n else n - 1


def _norm_task(t):
    """把一条原始任务字典归一化。
    load() 读盘、导入备份、回收站恢复都走这里 —— 规则只写一处，永远一致。"""
    p = t.get("p", 2)
    rp = str(t.get("repeat", "") or "")
    return {
        "id": t.get("id") or new_id(),
        "title": str(t.get("title", "")),
        "note": str(t.get("note", "")),
        "p": _norm_p(p),
        "due": norm_due(t.get("due", "")),
        "done": bool(t.get("done")),
        "order": float(t.get("order", 0) or 0) or now_ts(),
        "subs": _norm_subs(t.get("subs")),
        "logs": _norm_logs(t.get("logs")),
        "timer": _norm_num(t.get("timer")),
        "repeat": rp if rp in REPEAT_LABEL else "",
        "done_at": _norm_num(t.get("done_at")),
        # 创建时间。老数据没有这个字段就留 0，显示时由 created_ts() 回落到 order
        # ——**这里不要替它编一个值**，否则"回落到 order"这条路就再也走不到了。
        "created_at": _norm_num(t.get("created_at")),
        "remind_key": str(t.get("remind_key", "") or ""),
    }


def _norm_trash(raw):
    """回收站归一化。每项是 {"deleted_at": 时间戳, "task": 任务字典}。"""
    out = []
    if isinstance(raw, list):
        for it in raw:
            if not isinstance(it, dict):
                continue
            t = it.get("task")
            if not isinstance(t, dict) or not str(t.get("title", "")).strip():
                continue
            out.append({"deleted_at": _norm_num(it.get("deleted_at")),
                        "task": _norm_task(t)})
    return out[-TRASH_MAX:]


def add_months(d, n):
    """月份加减，自动处理月末对齐（1/31 加一个月 → 2/28 或 2/29）。"""
    y, m = divmod(d.month - 1 + n, 12)
    y, m = d.year + y, m + 1
    return datetime.date(y, m, min(d.day, calendar.monthrange(y, m)[1]))


def next_date(due_s, repeat, base=None):
    """算出重复任务的「下一次」截止日期。

    基准取原截止日期，没有就从今天算起，然后加一个周期。
    若结果已经过去（任务拖了很久才被完成），就一直往后推，直到落在
    今天之后 —— 这样不会一次补出一长串过期的重复任务。"""
    if repeat not in ("daily", "weekly", "monthly", "yearly"):
        return ""
    T = base or today()
    d = s2d(due_s) or T
    for _ in range(4000):
        if repeat == "daily":
            d = d + datetime.timedelta(days=1)
        elif repeat == "weekly":
            d = d + datetime.timedelta(days=7)
        elif repeat == "monthly":
            d = add_months(d, 1)
        else:
            d = add_months(d, 12)
        if d > T:
            break
    # 原来带具体时刻的（每天 18:30 这种），下一次也保持同一时刻 ——
    # 用户设的是"每天下班前"，不是"每天零点"。
    dt0 = parse_dt(due_s)
    if dt0 and due_has_time(due_s):
        return "%s %s" % (d2s(d), dt0.strftime("%H:%M:%S"))
    return d2s(d)


def done_ts(t):
    """完成时间戳（秒级）；判断不出来返回 0。

    优先 done_at；老数据没有这个字段就用 order 兜底，但只在 order 看着
    确实像时间戳时才用 —— 免得把「第 3 位」这种排序号当成 1970 年。
    """
    if not t.get("done"):
        return 0.0
    ts = _norm_num(t.get("done_at"))
    if ts > 0:
        return ts
    o = _norm_num(t.get("order"))
    return o if o > 1e9 else 0.0


def done_day(t):
    """任务是在哪一天完成的（复盘热力图要用）。"""
    ts = done_ts(t)
    return ts_day(ts) if ts > 0 else ""


# 大于这个值才认为"这是个像样的时间戳"（2001 年之后）。种子数据和早期版本
# 里的 order 是 1.0 / 2.0 这种排序号，拿它当时间会算出 1970 年。
TS_OK = 1e9


def created_ts(t):
    """任务的创建时间戳；判断不出来就返回 0（卡片上那一行就不画）。

    优先 created_at（v3 之后新建的任务都有）；老数据没有这个字段，就回落到
    order —— order 是创建时写的时间戳，只是后来会被拖拽排序反复改写，所以
    只能当"参考值"，不能当准。判断逻辑跟 done_day() 是同一套。
    """
    ts = _norm_num(t.get("created_at"))
    if ts > TS_OK:
        return ts
    o = _norm_num(t.get("order"))
    return o if o > TS_OK else 0.0


def short_day(s, ref):
    """'YYYY-MM-DD' → 'MM-DD'；不是今年才带上两位年（跨年时不至于有歧义）。"""
    d = s2d(s) if s else None
    if d is None:
        return ""
    if d.year != ref.year:
        return "%02d-%02d-%02d" % (d.year % 100, d.month, d.day)
    return "%02d-%02d" % (d.month, d.day)


def meta_line(t, ref=None):
    """卡片标题右端那行小字：创建 / 完成时间，**精确到秒**。

    两种样子：
      未完成 → 「建于 10-15 14:23:05」
      已完成 → 「完成 10-17 09:12:33」

    用户的原话：「日期应该要精确到具体的小时分钟和秒，当前只有年月日」。
    所以这里不再压缩成「建于 10-15」这种只到日期的写法 —— 复盘时要能看出
    「这件事是上午建的还是晚上建的、是当天上午还是拖到半夜才划掉的」。
    同一天建当天完，这两个时刻摆在一起自然就看得出来，不用再说"当天完成"。

    「用了多久」挪到卡片底部那颗药丸上（usage_text）—— 标题这一行放不下
    两个时间点，而"什么时候建的 / 什么时候完的"才是用户要的精确时刻。

    没开显示（SHOW_TIME 假）时返回 ""。**这时候标题会拿回全部宽度**，
    折行结果也跟着变，所以宽度只能走 _title_w()，别在别处另算一份。
    """
    if not SHOW_TIME:
        return ""
    ref = ref or today()
    if t.get("done"):
        d = fmt_ts(done_ts(t), ref)
        # 老数据既没有 done_at 也没有像样的 order：只能退回"建于"
        if d:
            return "完成 " + d
    c = fmt_ts(created_ts(t), ref)
    return ("建于 " + c) if c else ""


def usage_text(t):
    """已完成的任务用了多久 —— 显示在底部徽章行（原来放「＋ 日期」那个位置）。

    精度跟着量级走，别写「0 天」也别写「7200 秒」：
      不到 1 分钟 → 用时 38 秒
      不到 1 小时 → 用时 12 分 05 秒
      不到 1 天   → 用时 3 小时 12 分
      更长        → 用时 2 天 3 小时
    两个时间戳都拿不到就返回 ""（那种卡片的这个位置就不画了）。
    """
    if not t.get("done"):
        return ""
    a, b = created_ts(t), done_ts(t)
    if a <= 0 or b <= 0 or b < a:
        return ""
    sec = int(round(b - a))
    if sec < 60:
        return "用时 %d 秒" % sec
    if sec < 3600:
        m, r = divmod(sec, 60)
        return "用时 %d 分" % m if r == 0 else "用时 %d 分 %02d 秒" % (m, r)
    if sec < 86400:
        h, r = divmod(sec, 3600)
        m = r // 60
        return "用时 %d 小时" % h if m == 0 else "用时 %d 小时 %d 分" % (h, m)
    d, r = divmod(sec, 86400)
    h = r // 3600
    return "用时 %d 天" % d if h == 0 else "用时 %d 天 %d 小时" % (d, h)


def month_grid(year, month):
    """某个月的日历网格：[[date 或 None] × 7, …]，**周一开头**（跟 date.weekday 一致）。

    行数按实际需要给（4~6 行），不满的那一行右边补 None —— 固定 6 行会让
    2 月那种小月份底下多出一条空白，日历看着像坏了。
    """
    first = datetime.date(int(year), int(month), 1)
    ndays = calendar.monthrange(int(year), int(month))[1]
    weeks, week = [], [None] * first.weekday()
    for i in range(ndays):
        week.append(first + datetime.timedelta(days=i))
        if len(week) == 7:
            weeks.append(week)
            week = []
    if week:
        weeks.append(week + [None] * (7 - len(week)))
    return weeks


def _hint_entry(parent, hint, width=12, font=None):
    """空着的时候显示**浅色格式提示**的输入框。

    聚焦 → 提示自动清掉、字变深；失焦还空着 → 提示放回去。
    **提示不是值**：取值一律走 hint_value()，否则"没填时间"会被读成
    "18:30:05"，一个本来整天截止的任务就变成了到点提醒。
    """
    e = tk.Entry(parent, font=font or F_BODY, width=width, bg=C_WHITE, fg=C_INK3,
                 relief="flat", highlightthickness=1, highlightbackground=C_LINE,
                 highlightcolor="#c0ae8e", insertbackground=C_INK)
    e._hint = str(hint)
    e._hint_on = True
    e.insert(0, e._hint)

    def on_in(_e=None):
        if e._hint_on:
            e.delete(0, "end")
            e._hint_on = False
            e.configure(fg=C_INK)

    def on_out(_e=None):
        if not e.get().strip():
            hint_set(e, "")

    e.bind("<FocusIn>", on_in)
    e.bind("<FocusOut>", on_out)
    return e


def hint_value(e):
    """输入框里**真正的值** —— 正显示着浅色提示时算空。"""
    if getattr(e, "_hint_on", False):
        return ""
    return e.get().strip()


def hint_set(e, text):
    """写值：有值就正常显示；空值 → 回到浅色提示。"""
    text = str(text or "").strip()
    e.delete(0, "end")
    if text:
        e._hint_on = False
        e.configure(fg=C_INK)
        e.insert(0, text)
    else:
        e._hint_on = True
        e.configure(fg=C_INK3)
        e.insert(0, e._hint)


def round_rect(cv, x1, y1, x2, y2, r, **kw):
    r = min(r, (x2 - x1) / 2, (y2 - y1) / 2)
    pts = [x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r, x2, y2,
           x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r, x1, y1 + r, x1, y1]
    return cv.create_polygon(pts, smooth=True, **kw)


class App:

    # ============================================================ 初始化

    def __init__(self, root):
        self.root = root
        self.tasks = []
        self.mode = "matrix"
        self.filter = "all"
        self.q = ""
        self.quick_p = 2
        self.regions = []          # (kind, tid, x1, y1, x2, y2) 按绘制层次排列
        self._quad_rects = {}      # p -> (x, y, w, h)
        # 拖拽落点判定用的两份几何快照（每次重绘重算）：
        #   _nest_zone：卡片上半张（标题+备注那一段）＝「变成它的子任务」落点
        #   _sub_rows ：某张卡片里子任务行的 y 区间，按显示顺序 —— 子任务拖拽排序用
        self._nest_zone = {}
        self._sub_rows = {}
        # 子任务翻到的页码：{任务id: 第几页}。只活在内存里（不落库）——
        # 「上次翻到第二页」不值得存盘，重开程序回到第一页反而更不容易迷路。
        self.sub_page = {}
        self.quad_page = {}        # 象限 p -> 当前翻到第几页（只活在内存里）
        self.drag = None
        self.editor = None
        self.hover_tid = None
        self._redraw_job = None
        self._stats_win = None     # 耗时统计面板（Toplevel）
        self._stats_period = "today"
        self.trash = []            # 回收站：[{"deleted_at": 时间戳, "task": {...}}]
        self._review_win = None    # 每日复盘面板
        self._review_cv = None     # 复盘面板里那个可滚动的画布
        self._review_win_id = None
        self._trash_win = None     # 回收站面板
        self._help_win = None      # 使用帮助窗
        self._remind_win = None    # 到点提醒窗
        self._undo_cb = None       # 状态栏「撤销」当前绑定的动作
        self._undo_job = None
        # 提醒节流的时间基准。这里初始化成"现在"而不是 0 ——
        # 否则 __init__ 里第一次 _tick 就会立刻满足"距上次检查超过
        # REMIND_MS"，主窗口还没显示就先蹦出一个提醒框。
        # 启动时的那次检查交给下面单独的 after() 去做。
        self._last_remind_check = now_ts()

        self.load()
        self.topmost = bool(self.ui.get("topmost"))

        root.title(APP_TITLE)
        root.configure(bg=C_BG)
        root.minsize(760, 480)
        self._place_window()

        self._build_top()
        self._build_board()
        self._build_status()
        self._apply_topmost(announce=False)   # 恢复上次的置顶状态，并点亮按钮

        root.protocol("WM_DELETE_WINDOW", self.on_close)
        root.bind("<F5>", lambda e: self.redraw())
        root.bind("<Control-n>", lambda e: self.entry.focus_set())
        root.bind("<Control-t>", lambda e: self.toggle_top())
        root.bind("<Control-b>", lambda e: self.open_stats())
        root.bind("<Control-e>", lambda e: self.open_review())     # e = 复盘
        root.bind("<Control-z>", lambda e: self._do_undo())        # 撤销上一步删除
        root.bind("<F1>", lambda e: self.open_help())              # 使用帮助
        root.bind("<Escape>", lambda e: self.cancel_editor())
        root.bind_all("<MouseWheel>", self._on_wheel)

        self.refresh_quick()
        self.refresh_view_btns()
        self.redraw()
        self.entry.focus_set()

        # 启动时补一份今天的备份（如果今天还没备过）
        p = self._maybe_daily_backup()
        if p:
            self.status.configure(text="已自动备份到 %s" % p)

        self._tick()               # 开始心跳：计时中的卡片要持续刷新
        # 稍等一下再检查提醒，免得窗口还没画完就先蹦出一个提示框
        self.root.after(1500, self._maybe_remind)

    def _place_window(self):
        w, h = self.ui.get("w", 1180), self.ui.get("h", 820)
        x, y = self.ui.get("x"), self.ui.get("y")
        if x is None or y is None:
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
            x, y = max(0, (sw - w) // 2), max(0, (sh - h) // 3)
        self.root.geometry("%dx%d+%d+%d" % (w, h, x, y))

    # ============================================================ 数据持久化

    def load(self):
        self.ui = {}
        self.trash = []
        if not os.path.exists(DATA_FILE):
            self.tasks = self._seed()
            return
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                raw = json.load(f)
        except Exception:
            self.tasks = self._seed()
            return

        if isinstance(raw, list):
            items, self.ui = raw, {}
        else:
            items = raw.get("tasks", [])
            if not isinstance(items, list):
                items = []
            self.ui = raw.get("ui", {}) or {}

        self.mode = self.ui.get("mode", "matrix")
        self.filter = self.ui.get("filter", "all")
        self.quick_p = _norm_p(self.ui.get("quick_p", 2))
        # 「卡片上是否显示创建 / 完成时间」是个全局开关，同步到模块级
        # （block_h() 是纯函数、拿不到 App，只能这么传，见 set_show_time）。
        # 默认开——用户主动要的功能，默认关掉会显得"没做出来"。
        set_show_time(self.ui.get("show_time", True))
        # 象限名字也是用户数据，启动时装回去（同样是模块级，理由同上：
        # 绘制、右键菜单、统计面板都直接读 PRIOS）。
        apply_quad_labels(self.ui.get("quads"))

        out = []
        for t in items:
            if not isinstance(t, dict) or not str(t.get("title", "")).strip():
                continue
            out.append(_norm_task(t))
        self.tasks = out
        # 回收站（老数据没有这一段，取不到就是空的）
        self.trash = _norm_trash(raw.get("trash") if isinstance(raw, dict) else [])

    def _seed(self):
        d = today()
        # 示例数据里的创建时间刻意做出前后差别（今天 / 前天 / 三天前），
        # 这样第一次打开就能看到卡片底部那行时间是"活的"，不是摆设。
        def born(days_ago=0):
            return now_ts() - 86400 * days_ago

        return [
            {"id": new_id(), "title": "把季度复盘 PPT 改完，明天下午 3 点前发出去",
             "note": "重点补上留存率那一页", "p": 0, "due": d2s(d + datetime.timedelta(days=1)),
             "done": False, "order": 1.0, "created_at": born(2),
             "subs": [{"id": new_sid(), "text": "补留存率那一页的数据", "done": True},
                      {"id": new_sid(), "text": "改封面和字体统一", "done": False},
                      {"id": new_sid(), "text": "发到评审群里", "done": False}],
             "logs": {d2s(d - datetime.timedelta(days=1)): 2700.0,
                      d2s(d): 1800.0},
             "timer": 0},
            {"id": new_id(), "title": "回复同事发来的报销单确认", "note": "十分钟的事，别拖着",
             "p": 2, "due": d2s(d), "done": False, "order": 2.0, "created_at": born(0),
             "subs": [], "logs": {}, "timer": 0},
            {"id": new_id(), "title": "梳理下季度产品路线图", "note": "不着急，但别拖成 P0",
             "p": 1, "due": "", "done": False, "order": 3.0, "created_at": born(3),
             "subs": [], "logs": {d2s(d - datetime.timedelta(days=2)): 3600.0}, "timer": 0},
            {"id": new_id(), "title": "整理桌面上那堆截图，归档到 NAS", "note": "有空再说",
             "p": 3, "due": "", "done": False, "order": 4.0, "created_at": born(1),
             "subs": [], "logs": {}, "timer": 0},
        ]

    def _write_data(self):
        """把当前状态写进 tasks.json。先写 .tmp 再 os.replace，避免写坏原文件。"""
        data = {
            "v": 3,
            "ui": {
                "mode": self.mode, "filter": self.filter,
                "quick_p": self.quick_p, "topmost": bool(self.topmost),
                "show_time": bool(SHOW_TIME),
                "quads": quad_labels(),
                "w": self.root.winfo_width(), "h": self.root.winfo_height(),
                "x": self.root.winfo_x(), "y": self.root.winfo_y(),
                "backup_dir": self.ui.get("backup_dir", ""),
                "backup_on": bool(self.ui.get("backup_on", True)),
                "backup_keep": self._keep_days(),
                "last_backup": self.ui.get("last_backup", ""),
                "remind_on": bool(self.ui.get("remind_on", True)),
            },
            "tasks": self.tasks,
            "trash": self.trash,
        }
        try:
            tmp = DATA_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            os.replace(tmp, DATA_FILE)
        except Exception as e:
            # 存盘失败**不能静默**。源码版跑在仓库里，写不进去基本不可能发生；
            # 但打包成 exe 之后，用户很容易把它丢进 C:\Program Files 这类受保护
            # 目录 —— 那里写文件会被系统拒绝。以前这里是 `pass`，表现就是
            # 「改了一整天任务，关掉再开全没了」，而且一句提示都没有。
            # 只提示第一次，否则每次拖动都弹一个框。
            if not getattr(self, "_save_warned", False):
                self._save_warned = True
                try:
                    tkmb.showwarning(
                        "任务存不进去",
                        "数据要写在程序旁边的这个文件里：\n\n%s\n\n"
                        "但写失败了：%s\n\n"
                        "最常见的原因是程序放在了 C:\\Program Files 这类"
                        "需要管理员权限的目录。\n"
                        "把整个文件夹挪到桌面或 D 盘再打开就好了 ——"
                        "数据是跟着程序走的，换回去之后原来的任务还在。"
                        % (DATA_FILE, e))
                except Exception:
                    pass

    def save(self):
        self._write_data()
        self._maybe_daily_backup()

    # ============================================================ 每日自动备份

    def backup_dir(self):
        return str(self.ui.get("backup_dir") or "")

    def _keep_days(self):
        """备份保留天数。0 或负数 = 永久保留。

        注意别写成 `int(x or 30)` —— 那样 0 是假值会被替换成 30，
        「永久保留」就悄悄退化成了「保留 30 天」。这个坑踩过一次。"""
        try:
            return int(self.ui.get("backup_keep", 30))
        except (TypeError, ValueError):
            return 30

    def _maybe_daily_backup(self, force=False):
        """每天往备份文件夹落一份快照。挂在 save() 上，但正常情况下只是一次
        内存里的日期比对 —— 真正复制文件一天只发生一次，开销可以忽略。

        返回写出的路径；没做事则返回 ""。"""
        if not force and not self.ui.get("backup_on", True):
            return ""
        bd = self.backup_dir()
        if not bd or not os.path.isdir(bd):
            return ""
        key = d2s(today())
        dst = os.path.join(bd, BACKUP_PREFIX + key + ".json")
        if not force and self.ui.get("last_backup") == key and os.path.exists(dst):
            return ""
        if force:
            self._write_data()          # 手动备份时先把最新状态落盘
        try:
            shutil.copyfile(DATA_FILE, dst)
        except Exception:
            return ""
        self.ui["last_backup"] = key
        self._prune_backups()
        return dst

    def _prune_backups(self):
        """按保留天数清理旧备份。只碰自己生成的文件（前缀 + 合法日期），
        且日期一律从文件名解析，绝不按修改时间去猜。"""
        bd = self.backup_dir()
        keep = self._keep_days()
        if keep <= 0:                   # 0 或负数 = 永久保留
            return
        cutoff = today() - datetime.timedelta(days=keep - 1)
        try:
            names = os.listdir(bd)
        except Exception:
            return
        for n in names:
            if not (n.startswith(BACKUP_PREFIX) and n.endswith(".json")):
                continue
            d = s2d(n[len(BACKUP_PREFIX):-5])
            if d and d < cutoff:
                try:
                    os.remove(os.path.join(bd, n))
                except Exception:
                    pass

    def do_export(self):
        """手动导出一份到程序目录（不依赖备份文件夹的设置）。"""
        self._write_data()
        dst = os.path.join(APP_DIR, BACKUP_PREFIX + d2s(today()) + ".json")
        try:
            shutil.copyfile(DATA_FILE, dst)
        except Exception:
            self.status.configure(text="备份失败：数据文件还没生成")
            return
        self.status.configure(text="已备份到 %s" % dst)

    def do_backup_now(self):
        if not self.backup_dir():
            self.status.configure(text="还没设自动备份文件夹，先选「设置自动备份文件夹…」")
            return
        p = self._maybe_daily_backup(force=True)
        if p:
            self.status.configure(text="已备份到 %s" % p)
        else:
            self.status.configure(text="备份失败：请检查备份文件夹是否存在且可写")

    def pick_backup_dir(self):
        bd = tkfd.askdirectory(title="选择自动备份文件夹",
                               initialdir=self.backup_dir() or APP_DIR)
        if not bd:
            return
        self.ui["backup_dir"] = os.path.normpath(bd)
        self.ui["last_backup"] = ""     # 换了目录，今天该在新目录里补一份
        self.save()
        p = self._maybe_daily_backup(force=True)
        self.status.configure(text="备份文件夹已设为 %s%s"
                                   % (self.ui["backup_dir"],
                                      "，已写入今日备份" if p else ""))

    def open_backup_dir(self):
        bd = self.backup_dir()
        if not bd or not os.path.isdir(bd):
            self.status.configure(text="还没设置自动备份文件夹")
            return
        self._open_path(bd)

    def _open_path(self, path):
        """用系统默认方式打开文件或文件夹。"""
        try:
            if hasattr(os, "startfile"):
                os.startfile(path)
                return
            import subprocess
            opener = "open" if sys.platform == "darwin" else "xdg-open"
            subprocess.Popen([opener, path])
        except Exception:
            self.status.configure(text="打开失败：%s" % path)

    def toggle_backup(self):
        self.ui["backup_on"] = not bool(self.ui.get("backup_on", True))
        if self.ui["backup_on"]:
            self.ui["last_backup"] = ""     # 刚打开就立刻补一份
        self.save()
        self.status.configure(text="每日自动备份已%s"
                                   % ("开启" if self.ui["backup_on"] else "关闭"))

    def set_backup_keep(self, n):
        self.ui["backup_keep"] = int(n)
        self.save()
        self.status.configure(text="备份保留：%s"
                                   % ("永久" if int(n) <= 0 else "%d 天" % int(n)))

    # -------- 导入 / 恢复 --------

    def backup_before_import(self):
        """导入会覆盖或追加数据，动手前先留一份"后悔药"。
        返回写出的路径；失败返回 ""。"""
        self._write_data()
        name = (IMPORT_BACKUP_PREFIX
                + datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + ".json")
        dst = os.path.join(APP_DIR, name)
        try:
            shutil.copyfile(DATA_FILE, dst)
        except Exception:
            return ""
        return dst

    def read_backup(self, path):
        """读一个备份文件，返回 (任务列表, 错误信息)。

        这个函数只读不写，所以可以被测试反复调用 —— 把"解析"和"落地"
        分开，是让这类功能可测的关键。"""
        try:
            with open(path, "r", encoding="utf-8") as f:
                raw = json.load(f)
        except Exception as ex:
            return None, "读不了这个文件：%s" % ex
        if isinstance(raw, list):
            items = raw
        elif isinstance(raw, dict):
            items = raw.get("tasks", [])
        else:
            items = None
        if not isinstance(items, list):
            return None, "这不像是一份便利贴备份（里面找不到任务列表）"
        out = [_norm_task(t) for t in items
               if isinstance(t, dict) and str(t.get("title", "")).strip()]
        if not out:
            return None, "文件里没有任何可用的任务"
        return out, ""

    def import_from(self, path, mode="merge"):
        """真正执行导入。mode 取 "merge"（追加）或 "replace"（替换）。
        返回 (导入条数, 错误信息)。"""
        items, err = self.read_backup(path)
        if err:
            return 0, err
        self.backup_before_import()

        if mode == "replace":
            self.tasks = items
        else:
            have = set(t["id"] for t in self.tasks)
            for t in items:
                if t["id"] in have:          # 同 id 的补一个新 id，免得互相顶掉
                    t = dict(t, id=new_id())
                self.tasks.append(t)
        self.save()
        self.redraw()
        return len(items), ""

    def do_import(self):
        """菜单入口：选文件 → 问「替换还是合并」→ 执行。"""
        path = tkfd.askopenfilename(
            title="选择要导入的备份文件",
            initialdir=self.backup_dir() or APP_DIR,
            filetypes=[("便利贴备份", "*.json"), ("所有文件", "*.*")])
        if not path:
            return
        items, err = self.read_backup(path)
        if err:
            tkmb.showerror("导入失败", err, parent=self.root)
            return
        ans = tkmb.askyesnocancel(
            "导入方式",
            "文件里有 %d 条任务。\n\n"
            "「是」= 替换：清掉现在的全部任务，只保留文件里的\n"
            "「否」= 合并：保留现有任务，把文件里的追加进来\n"
            "「取消」= 什么都不做\n\n"
            "无论选哪个，都会先自动留一份「%s…」以防万一。"
            % (len(items), IMPORT_BACKUP_PREFIX),
            parent=self.root)
        if ans is None:
            return
        n, err = self.import_from(path, "replace" if ans else "merge")
        if err:
            tkmb.showerror("导入失败", err, parent=self.root)
            return
        self.status.configure(text="已导入 %d 条任务（%s）"
                                   % (n, "替换" if ans else "合并"))

    # ============================================================ 界面骨架

    def _btn(self, parent, text, cmd, primary=False, width=None):
        bg = C_INK if primary else C_WHITE
        fg = "#ffffff" if primary else C_INK
        b = tk.Button(parent, text=text, command=cmd, font=F_SMALL,
                      bg=bg, fg=fg, activebackground=("#3d3830" if primary else "#f2eee6"),
                      activeforeground=fg, relief="flat", bd=0, padx=13, pady=6,
                      cursor="hand2", highlightthickness=0)
        if width:
            b.configure(width=width)
        return b

    def _build_top(self):
        top = tk.Frame(self.root, bg=C_TOP, highlightbackground=C_LINE,
                       highlightthickness=0)
        top.pack(fill="x", side="top")
        inner = tk.Frame(top, bg=C_TOP)
        inner.pack(fill="x", padx=PAD, pady=(11, 10))

        # --- 第一行：快速添加 ---
        r1 = tk.Frame(inner, bg=C_TOP)
        r1.pack(fill="x")

        tk.Label(r1, text="● 便利贴", font=F_BRAND, bg=C_TOP, fg=C_INK).pack(side="left", padx=(0, 12))

        self.entry = tk.Entry(r1, font=F_BODY, bg=C_WHITE, fg=C_INK, relief="flat",
                              highlightthickness=1, highlightbackground=C_LINE,
                              highlightcolor="#c0ae8e", insertbackground=C_INK)
        self.entry.pack(side="left", fill="x", expand=True, ipady=5, padx=(0, 9))
        self.entry.bind("<Return>", lambda e: self.do_add())
        self.entry.bind("<Escape>", lambda e: self.entry.delete(0, "end"))

        # 象限可以增删，所以这排按钮不能只建一次（数量变了要重建，见 _rebuild_quick）
        self.seg = tk.Frame(r1, bg=C_WHITE, highlightbackground=C_LINE, highlightthickness=1)
        self.seg.pack(side="left", padx=(0, 9))
        self.seg_btns = []
        self._rebuild_quick()

        self._btn(r1, "贴 上", self.do_add, primary=True).pack(side="left")

        # --- 第二行：工具与统计 ---
        r2 = tk.Frame(inner, bg=C_TOP)
        r2.pack(fill="x", pady=(9, 0))

        self.view_btn = self._btn(r2, "四象限", self.toggle_view)
        self.view_btn.pack(side="left", padx=(0, 7))

        self.filter_btn = self._btn(r2, "全部 ▾", self.show_filter_menu)
        self.filter_btn.pack(side="left", padx=(0, 7))

        tk.Label(r2, text="搜索", font=F_SMALL, bg=C_TOP, fg=C_INK3)\
            .pack(side="left", padx=(0, 4))
        self.search = tk.Entry(r2, font=F_SMALL, bg=C_WHITE, fg=C_INK, relief="flat",
                               highlightthickness=1, highlightbackground=C_LINE,
                               highlightcolor="#c0ae8e", insertbackground=C_INK, width=15)
        self.search.pack(side="left", ipady=4, padx=(0, 7))
        self.search.bind("<KeyRelease>", self.on_search)

        self._btn(r2, "统计", self.open_stats).pack(side="left", padx=(0, 7))
        self._btn(r2, "复盘", self.open_review).pack(side="left", padx=(0, 7))
        # 固定 width=4：让「置顶 / 已置顶」两种文字占同样宽，切换时工具栏不抖
        # （实测 width=None 时 51px↔62px 会左右晃，width=4 两者都是 56px）
        self.top_btn = self._btn(r2, "置顶", self.toggle_top, width=4)
        self.top_btn.pack(side="left", padx=(0, 7))
        self.more_btn = self._btn(r2, "更多 ▾", self.show_more_menu)
        self.more_btn.pack(side="left", padx=(0, 7))

        # 帮助放**最右边**（side="right"）：既不挤现有的按钮，位置也符合习惯。
        # 文案带个问号，是给第一次用的人（比如拷给朋友的电脑）一个明显的抓手。
        self.help_btn = self._btn(r2, "? 帮助", self.open_help)
        self.help_btn.pack(side="right")

        tk.Frame(self.root, bg=C_LINE, height=1).pack(fill="x")

    def _build_board(self):
        wrap = tk.Frame(self.root, bg=C_BG)
        wrap.pack(fill="both", expand=True)

        self.cv = tk.Canvas(wrap, bg=C_BG, highlightthickness=0, bd=0)
        self.cv.pack(side="left", fill="both", expand=True)

        self.sb = tk.Scrollbar(wrap, orient="vertical", command=self.cv.yview,
                               width=12, troughcolor=C_BG, bg="#d9d3c7",
                               activebackground="#c4bdaf", relief="flat", bd=0)
        self.sb.pack(side="right", fill="y")
        self.cv.configure(yscrollcommand=self.sb.set)

        self.cv.bind("<Configure>", self.on_configure)
        self.cv.bind("<ButtonPress-1>", self.on_press)
        self.cv.bind("<B1-Motion>", self.on_motion)
        self.cv.bind("<ButtonRelease-1>", self.on_release)
        self.cv.bind("<Double-Button-1>", self.on_double)
        self.cv.bind("<Button-3>", self.on_right)
        self.cv.bind("<Motion>", self.on_hover)
        # 点到输入框以外的地方就提交就地编辑（代替不可靠的 FocusOut 提交）
        self.root.bind_all("<Button-1>", self._maybe_commit_editor, add="+")

    def _build_status(self):
        bar = tk.Frame(self.root, bg=C_TOP, highlightbackground=C_LINE, highlightthickness=0)
        bar.pack(fill="x", side="bottom")
        tk.Frame(bar, bg=C_LINE, height=1).pack(fill="x")

        # 用 grid 而不是 pack：撤销按钮要能反复隐藏/出现，而且不能把
        # 右边的统计数字挤来挤去（pack 的 side="right" 顺序会变）。
        row = tk.Frame(bar, bg=C_TOP)
        row.pack(fill="x", padx=PAD, pady=5)
        row.columnconfigure(0, weight=1)

        self.status = tk.Label(row, font=F_SMALL, bg=C_TOP, fg=C_INK3,
                               anchor="w", justify="left", text=HINT_TEXT)
        self.status.grid(row=0, column=0, sticky="w")

        self.undo_btn = self._btn(row, "撤销", self._do_undo)
        self.undo_btn.grid(row=0, column=1, padx=(10, 0))
        self.undo_btn.grid_remove()          # 平时藏起来，删除后才露面

        # 统计数字挪到底部右侧，给顶栏腾出放按钮的地方。
        # 它们不只是数字，还是**切筛选的按钮**（见 STAT_CHIPS / chip_filter）：
        # 用户找不到"已完成的任务在哪儿"，就是因为唯一的入口藏在顶栏
        # 那个「全部 ▾」里，而这几个数字自己不可点、也不像控件。
        self.stat_box = tk.Frame(row, bg=C_TOP)
        self.stat_box.grid(row=0, column=2, padx=(10, 0))
        self.stat_chips = {}
        for i, (k, _label) in enumerate(STAT_CHIPS):
            # 白底 + 细边 = 一眼就是按钮。只写文字的话，用户照样会说
            # "我发现没有任何的按钮"（这正是他报的原话）。
            # padx / 左间距刻意收得比较小：这排胶囊比原来那串纯文字宽了
            # 一百多像素，窗口缩到最小（MIN_W）时得跟左边的提示一起装下。
            lab = tk.Label(self.stat_box, text="", font=F_SMALL, bg=C_WHITE,
                           fg=C_INK2, padx=6, pady=1, cursor="hand2", bd=0,
                           highlightthickness=1, highlightbackground=C_LINE,
                           highlightcolor=C_LINE)
            # 用 grid 而不是 pack：数量为 0 的项要能藏起来，
            # 而 grid_remove() 会记住位置，再 grid() 就回到原来的次序
            # （pack_forget 后再 pack 会跑到最后一个去）。
            lab.grid(row=0, column=i, padx=(3, 0))
            lab.grid_remove()
            lab.bind("<Button-1>", lambda e, kk=k: self.chip_filter(kk))
            lab.bind("<Enter>", lambda e, kk=k: self._chip_paint(kk, hover=True))
            lab.bind("<Leave>", lambda e, kk=k: self._chip_paint(kk, hover=False))
            self.stat_chips[k] = lab

    # -------- 状态栏胶囊（统计数字 = 切筛选的按钮） --------

    def _chip_paint(self, k, hover=False):
        """胶囊的三种样子：当前视图（深底白字）/ 鼠标悬停 / 平常（白底细边）。

        边框颜色也跟着变，否则选中态那圈浅边会留在深底上。
        """
        lab = self.stat_chips.get(k) if getattr(self, "stat_chips", None) else None
        if lab is None:
            return
        if self.filter == k:
            bg, fg, line = C_INK, "#ffffff", C_INK
        elif hover:
            bg, fg, line = "#f2eee6", C_INK, "#cfc8ba"
        else:
            bg, fg, line = C_WHITE, C_INK2, C_LINE
        lab.configure(bg=bg, fg=fg, highlightbackground=line, highlightcolor=line)

    def chip_filter(self, k):
        """点状态栏胶囊：切到那个筛选。已经在这个筛选里，再点一次 = 回到全部
        （和顶栏筛选按钮同义，用户不用再去找别的出口）。"""
        self.set_filter("all" if self.filter == k else k)

    def clear_filters(self):
        """回到「全部」，并清掉搜索词 —— 板面空态里那个「看全部」用的。"""
        if self.q:
            self.q = ""
            self.search.delete(0, "end")
        self.set_filter("all")

    def _filter_hint(self, k):
        """切筛选时在状态栏左侧说一句「你现在看的是什么、怎么回去」。

        从胶囊点进来的用户尤其需要这句 —— 状态栏只管亮数字，不解释的话
        他们不知道自己被切到哪儿了。
        """
        if k == "all":
            return HINT_TEXT
        n_done = len([t for t in self.tasks if t["done"]])
        arch = len(self.archived_done())
        if k == "done":
            # 这句是回答"已完成 / 归档 到底啥区别"的地方：
            # 它们**不是两批任务**，后者只是前者里已经不在板面上的那部分。
            s = "这里是全部 %d 条已完成的任务" % n_done
            if arch:
                s += "，其中 %d 条已从板面收起（不是丢了）" % arch
            return s + " · 再点一次胶囊回到全部"
        name = dict(FILTERS).get(k, k)
        return "只显示「%s」的任务 · 再点一次胶囊回到全部" % name

    # ============================================================ 顶栏行为

    def _popup(self, menu, widget=None, x=None, y=None):
        """在某个控件正下方弹出菜单；也可以直接给坐标。"""
        if x is None:
            x = widget.winfo_rootx()
            y = widget.winfo_rooty() + widget.winfo_height()
        try:
            menu.tk_popup(x, y)
        finally:
            menu.grab_release()

    def build_more_menu(self):
        """只负责把菜单拼出来，不负责弹出 —— 这样它就能被测试直接调用。

        统计 / 复盘**不放在这里** —— 顶栏已经有专门的两个按钮了，
        菜单里再来一份纯属重复。（卡片右键菜单里那一份保留：在小卡片上
        右键时不用再跑去顶栏。）
        """
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        m.add_command(label="回收站…", command=self.open_trash)
        m.add_separator()

        m.add_command(label="导入 / 恢复备份…", command=self.do_import)
        bd = self.backup_dir()
        if bd:
            m.add_command(label="立即备份到现在的位置", command=self.do_backup_now)
        else:
            m.add_command(label="立即备份（暂存到程序目录）", command=self.do_export)
        m.add_command(label="设置自动备份文件夹…", command=self.pick_backup_dir)
        if bd:
            m.add_command(label="打开备份文件夹", command=self.open_backup_dir)
        m.add_command(label="每日自动备份：%s"
                            % ("开" if self.ui.get("backup_on", True) else "关"),
                      command=self.toggle_backup)

        sub = tk.Menu(m, tearoff=0, font=F_SMALL)
        cur = self._keep_days()
        for n, label in [(7, "7 天"), (30, "30 天"), (90, "90 天"), (0, "永久保留")]:
            sub.add_command(label=("● " if n == cur else "    ") + label,
                            command=lambda nn=n: self.set_backup_keep(nn))
        m.add_cascade(label="备份保留天数", menu=sub)
        m.add_separator()
        m.add_command(label="到点提醒：%s"
                            % ("开" if self.ui.get("remind_on", True) else "关"),
                      command=self.toggle_remind)
        # 时间这一行是纯显示选项，和功能开关不是一类，单独摆一行
        m.add_command(label="卡片上显示时间：%s" % ("开" if SHOW_TIME else "关"),
                      command=self.toggle_show_time)
        m.add_separator()
        # 象限名字是"我的这张板子长什么样"，也放这一组
        m.add_command(label="象限设置…（增删 / 改名）", command=lambda: self.ask_quads())
        m.add_separator()
        m.add_command(label="打开数据文件夹", command=lambda: self._open_path(APP_DIR))
        m.add_command(label="清空已完成", command=self.do_clear_done)
        return m

    def show_more_menu(self):
        self._popup(self.build_more_menu(), self.more_btn)

    def set_quick(self, i):
        self.quick_p = i
        self.refresh_quick()
        self.entry.focus_set()

    def _rebuild_quick(self):
        """按当前象限重建「这个任务贴进哪一格」那排小按钮。

        象限能增删，所以按钮数量会变 —— 只在 __init__ 里建一次的话，
        新增第 5 格之后就没有它的按钮了。padx 收到 8：8 个按钮也要塞得下。
        """
        for b in list(getattr(self, "seg_btns", [])):
            b.destroy()
        self.seg_btns = []
        for pr in PRIOS:
            b = tk.Button(self.seg, text=pr["key"], font=F_TINY, bd=0, relief="flat",
                          padx=8, pady=5, cursor="hand2", highlightthickness=0,
                          command=lambda i=pr["p"]: self.set_quick(i))
            b.pack(side="left")
            self.seg_btns.append(b)
        self.quick_p = max(0, min(int(self.quick_p or 0), len(PRIOS) - 1))
        self.refresh_quick()

    def refresh_quick(self):
        for b, pr in zip(self.seg_btns, PRIOS):
            on = pr["p"] == self.quick_p
            b.configure(bg=pr["band"] if on else C_WHITE,
                        fg="#ffffff" if on else C_INK2,
                        activebackground=pr["band"] if on else "#f4f1ea",
                        activeforeground="#ffffff" if on else C_INK2)

    def refresh_view_btns(self):
        self.view_btn.configure(text="四象限" if self.mode == "matrix" else "列表")
        self.filter_btn.configure(text=dict(FILTERS).get(self.filter, "全部") + " ▾")
        # 当前所处的筛选，用深底胶囊标出来（点胶囊进来的用户要能看见"我在哪儿"）
        for k in (getattr(self, "stat_chips", None) or {}):
            self._chip_paint(k)

    def toggle_view(self):
        self.mode = "list" if self.mode == "matrix" else "matrix"
        self.refresh_view_btns()
        self.save()
        self.redraw()

    def toggle_top(self):
        """开关窗口置顶（覆盖其他应用）。Ctrl+T 等效。"""
        self.topmost = not getattr(self, "topmost", False)
        self._apply_topmost()
        self.save()

    def _apply_topmost(self, announce=True):
        """把 self.topmost 落到窗口上，并同步按钮外观和已打开的子面板。

        announce=False 用在启动时恢复状态：那时不需要弹一句状态提示。
        """
        try:
            self.root.attributes("-topmost", bool(self.topmost))
        except Exception:
            pass
        self._paint_top_btn()
        self._sync_panel_topmost()
        if announce and getattr(self, "status", None) is not None:
            self.status.configure(
                text=("窗口已置顶，会盖在其他应用上面；再点一次「已置顶」即可取消"
                      if self.topmost else "已取消置顶，窗口恢复正常层级"))

    def _paint_top_btn(self):
        """让按钮自己显示当前状态：没置顶是白底「置顶」，置顶了是深底「已置顶」。"""
        b = getattr(self, "top_btn", None)
        if b is None:
            return
        on = bool(getattr(self, "topmost", False))
        bg = C_PIN_ON_BG if on else C_PIN_OFF_BG
        fg = C_PIN_ON_FG if on else C_PIN_OFF_FG
        # 悬停色沿用 c_btn 的规则：亮色底就压暗一点，暗色底就提亮一点
        hover = "#3d3830" if on else "#f2eee6"
        try:
            b.configure(text=("已置顶" if on else "置顶"),
                        bg=bg, fg=fg, activebackground=hover, activeforeground=fg)
        except Exception:
            pass

    def _follow_top(self, w):
        """新建的子面板登记进来，并跟随主窗口当前的置顶状态。

        为什么必须做：主窗口一旦设为 -topmost，它就压在普通窗口之上。
        统计 / 复盘 / 回收站这些面板若不管层级，就会被主窗挡在背后 ——
        表现为「点了按钮，界面什么也没发生」。
        """
        try:
            w.transient(self.root)
        except Exception:
            pass
        if getattr(self, "topmost", False):
            try:
                w.attributes("-topmost", True)
            except Exception:
                pass

    def _sync_panel_topmost(self):
        """主窗口切换置顶时，已打开的面板一起跟着变。

        提醒窗不在此列：它必须始终置顶，否则会被别人盖住导致提醒失效。
        """
        for attr in ("_stats_win", "_review_win", "_trash_win", "_help_win"):
            w = getattr(self, attr, None)
            if w is None:
                continue
            try:
                if w.winfo_exists():
                    w.attributes("-topmost", bool(self.topmost))
            except Exception:
                pass

    def build_filter_menu(self):
        """只负责把筛选菜单拼出来，不负责弹（菜单一弹就进模态循环，
        测试没法验它里面写了什么 —— 同 build_more_menu / build_card_menu）。"""
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        n_done = len([t for t in self.tasks if t["done"]])
        arch = len(self.archived_done())
        for k, label in FILTERS:
            if k == "done":
                # 这里是用户找「完成的任务去哪了」的第一站，把条数写出来，
                # 并点明「已收起」是「已完成」的一部分而不是另一批任务 ——
                # 光看状态栏那两个并列的数字，谁都会以为是两回事。
                label = "已完成（%d 条%s）" % (
                    n_done, "，含已收起 %d" % arch if arch else "")
            m.add_command(label=label, command=lambda kk=k: self.set_filter(kk))
        return m

    def show_filter_menu(self):
        self._popup(self.build_filter_menu(), self.filter_btn)

    def set_filter(self, k):
        self.filter = k
        self.refresh_view_btns()
        if getattr(self, "status", None) is not None:
            self.status.configure(text=self._filter_hint(k))
        self.save()
        self.redraw()

    def on_search(self, _e=None):
        self.q = self.search.get().strip()
        self.redraw()

    # ============================================================ 过滤

    def visible(self, t):
        if self.q:
            hay = " ".join([t["title"], t["note"]] + [s["text"] for s in subs_of(t)])
            if self.q.lower() not in hay.lower():
                return False
        T = today()
        due = s2d(t["due"]) if t["due"] else None
        f = self.filter
        if f == "open":
            return not t["done"]
        if f == "due":
            return (not t["done"]) and due is not None and due <= T
        if f == "overdue":
            return (not t["done"]) and is_overdue(t)
        if f == "running":
            return bool(t.get("timer")) and not t["done"]
        if f == "done":
            return t["done"]
        if t["done"] and not self.q:
            # 「已完成」的任务只留在板面上到**当天结束**，第二天起从这里隐去，
            # 只出现在「已完成」筛选里（否则象限一天天堆下去会变成历史垃圾场）。
            # 搜索时是例外：找东西就应该找得到，哪怕它已经收起了。
            return done_day(t) == d2s(T)
        return True

    def archived_done(self):
        """已经完成后又被收起（不是今天完成的）的那些 —— 状态栏用它报个数，
        不然任务"凭空少了一张"会让人以为丢了。"""
        T = d2s(today())
        return [t for t in self.tasks if t["done"] and done_day(t) != T]

    def sort_key(self, t):
        return (1 if t["done"] else 0, t["order"])

    # ============================================================ 布局与绘制

    def on_configure(self, e):
        if self._redraw_job:
            self.root.after_cancel(self._redraw_job)
        self._redraw_job = self.root.after(60, self.redraw)

    def redraw(self):
        self._redraw_job = None
        self.regions = []
        self._quad_rects = {}
        self._nest_zone = {}
        self._sub_rows = {}
        cv = self.cv
        cv.delete("all")

        W = cv.winfo_width()
        if W <= 1:
            self.root.after(80, self.redraw)
            return

        self._update_stats()
        show = [t for t in self.tasks if self.visible(t)]

        groups = []
        for pr in PRIOS:
            items = sorted([t for t in show if t["p"] == pr["p"]], key=self.sort_key)
            groups.append((pr, items))

        if not self.tasks:
            cv.create_text(W // 2, 150, text="📌", font=("Segoe UI Emoji", 30), fill="#cfc7b8")
            cv.create_text(W // 2, 200, text="还没有任务", font=("Microsoft YaHei UI", 13),
                           fill=C_INK3)
            cv.create_text(W // 2, 230, text="在上面的输入框写一句，按回车就贴上来了",
                           font=F_BODY, fill=C_INK3)
            cv.configure(scrollregion=(0, 0, W, 400))
            return

        if not show:
            # 筛选（或搜索）把任务全滤掉了。四象限每格只会写一句「暂无」，
            # 用户会以为任务丢了 —— 给一句解释 + 一个能点回去的地方。
            self._draw_empty_state(W)
            cv.configure(scrollregion=(0, 0, W, max(400, cv.winfo_height())))
            return

        if self.mode == "matrix":
            total_h = self._draw_matrix(groups, W)
        else:
            total_h = self._draw_list(groups, W)

        cv.configure(scrollregion=(0, 0, W, max(total_h, cv.winfo_height())))

    def _draw_empty_state(self, W):
        """筛选/搜索之后一张卡片都没有时，板面上画的那段话。

        它同时是**一个能点的按钮**（regions 里登记成 "emptyreset"）：
        点一下回到「全部」并清空搜索。不这么做的话，用户切到「已完成」
        发现是空的，就只能自己满窗口找别的出口，很容易卡在这儿。
        """
        cv = self.cv
        if self.q:
            title = "没找到含「%s」的任务" % self.q
            tip = "换个词试试，或者回到全部看所有任务"
            btn = "清空搜索，看全部"
        else:
            name = dict(FILTERS).get(self.filter, "全部")
            title = "「%s」里现在没有任务" % name
            if self.filter == "done":
                tip = "完成的任务会一直记在这儿，直到你清空它们"
            else:
                tip = "换个筛选看看，或者回到全部"
            btn = "← 回到全部"

        y = 140
        cv.create_text(W // 2, y, text=title,
                       font=("Microsoft YaHei UI", 13), fill=C_INK3)
        cv.create_text(W // 2, y + 32, text=tip, font=F_BODY, fill=C_INK3)

        bw = _font_of(F_SMALL).measure(btn) + 26
        bh = 28
        x1 = W // 2 - bw / 2.0
        y1 = y + 62
        round_rect(cv, x1, y1, x1 + bw, y1 + bh, 8,
                   fill=C_WHITE, outline=C_LINE, width=1)
        cv.create_text(x1 + bw / 2.0, y1 + bh / 2.0, text=btn,
                       font=F_SMALL, fill=C_INK)
        self.regions.append(("emptyreset", "", x1, y1, x1 + bw, y1 + bh))

    # -------- 四象限布局 --------
    def _draw_matrix(self, groups, W):
        # 象限数量是可变的：**两列排下来**，行数 = ceil(个数/2)。
        # 4 个时正好还是原来那个 2×2；6 个就是 3 行 2 列；奇数个最后一行
        # 只摆一个格子（照样占半宽，右边留白 —— 比拉成整行更像"少了一格"）。
        # 只有 1 个象限时才铺满整宽，否则半个窗口空着太怪。
        nq = len(groups)
        ncols = 1 if nq <= 1 else 2
        avail = W - PAD * (ncols + 1)
        colw = avail / ncols
        rows = [groups[i:i + ncols] for i in range(0, max(1, nq), ncols)]

        def ncol_of(colw_):
            inner_avail = colw_ - INNER * 2
            n = max(1, int((inner_avail + GAP) // (CARD_W + GAP)))
            return n, (inner_avail - (n - 1) * GAP) / n

        # 先算每格需要的高度 —— **只按本页的卡片算**（一个象限最多 QROWS 行）
        def quad_metrics(pr, items):
            ncol, cw = ncol_of(colw)
            page = self._quad_page(pr["p"], len(items), ncol)
            shown = self._quad_slice(items, page, ncol)
            rhs = row_heights(shown, ncol)   # 每行的高度：卡片不等高，取行内最高那张
            need = QHEAD + INNER + sum(rhs) + (len(rhs) - 1) * GAP + INNER
            return ncol, cw, max(need, QMIN_H)

        heights = []
        metrics = {}
        # 任务不多时让象限铺满窗口，避免下半屏大片留白。
        # **min_row 要按行数均分**：6 个象限时还给"半个窗口"一格高度，
        # 整块板子就会长到三屏。
        vis_h = self.cv.winfo_height()
        min_row = max(QMIN_H, (vis_h - PAD * (len(rows) + 1)) / max(1, len(rows)))
        for row in rows:
            hs, ms = [], []
            for pr, items in row:
                m = quad_metrics(pr, items)
                ms.append(m)
                hs.append(m[2])
            h = max(max(hs), min_row)
            heights.append(h)
            for (pr, items), m in zip(row, ms):
                metrics[pr["p"]] = m

        y = PAD
        for ri, row in enumerate(rows):
            for ci, (pr, items) in enumerate(row):
                x = PAD + ci * (colw + PAD)
                self._draw_quad(pr, items, x, y, colw, heights[ri], metrics[pr["p"]])
            y += heights[ri] + PAD
        return y

    # -------- 象限里的分页 --------

    def _quad_page(self, p, n_items, ncol):
        """这个象限当前翻到第几页（0 起）。**越界一律夹回** —— 删掉几条、
        或者某几条被"已完成次日收起"之后，内存里的页码可能指到不存在的页。"""
        per = max(1, int(ncol) * QROWS)
        pgs = max(1, -(-int(n_items) // per))
        pg = int(self.quad_page.get(p) or 0)
        pg = max(0, min(pg, pgs - 1))
        self.quad_page[p] = pg
        return pg

    def _quad_slice(self, items, page, ncol):
        """象限这一页要显示的卡片（items 已经按 sort_key 排好）。"""
        per = max(1, int(ncol) * QROWS)
        return items[page * per:(page + 1) * per]

    def turn_quad_page(self, p, d):
        """翻这个象限的一页（d = -1 上一页 / +1 下一页）。到头了就停住。"""
        ncol, _cw = self._ncol_now()
        items = sorted([t for t in self.tasks if t["p"] == p and self.visible(t)],
                       key=self.sort_key)
        per = max(1, ncol * QROWS)
        pgs = max(1, -(-len(items) // per))
        if pgs <= 1:
            return
        old = self._quad_page(p, len(items), ncol)
        new = max(0, min(old + d, pgs - 1))
        if new == old:
            return
        self.quad_page[p] = new
        self.redraw()

    def _ncol_now(self):
        """当前窗口下，一个象限里能放几列卡片（跟 _draw_matrix 同一个算法）。"""
        colw = (self.cv.winfo_width() - PAD * 3) / 2
        inner_avail = colw - INNER * 2
        n = max(1, int((inner_avail + GAP) // (CARD_W + GAP)))
        return n, (inner_avail - (n - 1) * GAP) / n

    def _draw_quad_pager(self, p, xr, y, pgs, pg, tag):
        """象限标题行右端的 ‹ 1/2 ›。返回它占的宽度。

        跟子任务那个翻页器同样的画法（折线箭头，不靠字体里的 ‹ ›），
        只是挂在象限标题行上、颜色稍重一点（它不常出现，出现就该被看见）。
        """
        cv = self.cv
        lbl = "%d/%d" % (pg + 1, pgs)
        pw = max(24, _font_of(F_SMALL).measure(lbl) + 6)
        h = 18
        n1, n2 = xr - 16, xr
        t1 = n1 - pw
        p1 = t1 - 16
        cy = y + 2 + h / 2.0
        round_rect(cv, p1 - 3, y, n2 + 3, y + h, 7,
                   fill=C_WHITE, outline=C_LINE, width=1, tags=(tag,))
        cv.create_text((t1 + n1) / 2.0, cy, text=lbl, font=F_SMALL,
                       fill=C_INK2, tags=(tag,))
        for (b1, b2, a, live, knd) in ((p1, t1, -1, pg > 0, "qprev"),
                                       (n1, n2, +1, pg < pgs - 1, "qnext")):
            cx = (b1 + b2) / 2.0
            ink = C_INK2 if live else "#c9c2b5"
            cv.create_line(cx - 3 * a, cy - 4, cx + 3 * a, cy, cx - 3 * a, cy + 4,
                           fill=ink, width=1.6, capstyle="round",
                           joinstyle="round", tags=(tag,))
            self.regions.append((knd, "Q%d" % p, b1 - 4, y - 2, b2 + 4, y + h + 2))
        return (n2 + 3) - (p1 - 3)

    # -------- 列表布局 --------
    def _draw_list(self, groups, W):
        inner_avail = W - PAD * 2 - INNER * 2
        ncol = max(1, int((inner_avail + GAP) // (CARD_W + GAP)))
        cw = (inner_avail - (ncol - 1) * GAP) / ncol
        y = PAD
        for pr, items in groups:
            rhs = row_heights(items, ncol)
            need = QHEAD + INNER + sum(rhs) + (len(rhs) - 1) * GAP + INNER
            need = max(need, QMIN_H)
            self._draw_quad(pr, items, PAD, y, W - PAD * 2, need, (ncol, cw, need))
            y += need + PAD
        return y

    def _draw_quad(self, pr, items, x, y, w, h, metrics):
        cv = self.cv
        ncol, cw, _ = metrics
        tag = "quad%d" % pr["p"]
        self._quad_rects[pr["p"]] = (x, y, w, h)

        hl = (self.drag and self.drag.get("target") == pr["p"])
        round_rect(cv, x, y, x + w, y + h, 10,
                   fill=(C_HL if hl else C_QUAD),
                   outline=(pr["band"] if hl else C_LINE), width=(2 if hl else 1),
                   tags=(tag, "qbg%d" % pr["p"]))

        # 标题行右端：任务总数；一个象限超过 QROWS 行就再挂一个 ‹ 1/2 › 翻页器。
        # 翻页器放在**象限这一栏**（用户的原话），不在卡片之间 —— 它管的是
        # 整个象限的翻页，挂在某张卡上会让人以为是那张卡在翻。
        #
        # ★ 先画右边：左边的名字要按"右边剩下的宽度"裁剪（名字可以被用户改得很长）。
        page = self._quad_page(pr["p"], len(items), ncol)
        shown = self._quad_slice(items, page, ncol)
        per = max(1, ncol * QROWS)
        pgs = max(1, -(-len(items) // per))
        if pgs > 1:
            pw = self._draw_quad_pager(pr["p"], x + w - INNER, y + 2, pgs, page, tag)
            cnt = "共 %d 条" % len(items)
            cv.create_text(x + w - INNER - pw - 8, y + 11, anchor="e",
                           text=cnt, font=F_TINY, fill=C_INK3, tags=(tag,))
            right_x = x + w - INNER - pw - 8 - _font_of(F_TINY).measure(cnt) - 8
        else:
            cnt = str(len(items))
            cv.create_text(x + w - INNER, y + 11, anchor="e", text=cnt,
                           font=F_TINY, fill=C_INK2, tags=(tag,))
            right_x = x + w - INNER - _font_of(F_TINY).measure(cnt) - 8

        # 头部：色点 + 名字 + 「· 备注」。名字和备注都是用户可改的，
        # 所以一律走 fit_quad_head 按剩余宽度裁剪，不能直接画。
        dot = 5
        cv.create_oval(x + INNER, y + 11 - dot, x + INNER + dot * 2, y + 11 + dot,
                       fill=pr["band"], outline="", tags=(tag,))
        hx = x + INNER + 17
        nm_txt, act_txt = fit_quad_head(pr["name"], pr["act"], right_x - hx)
        cv.create_text(hx, y + 11, anchor="w", text=nm_txt,
                       font=F_HEAD, fill=C_INK, tags=(tag,))
        if act_txt:
            nm = _font_of(F_HEAD).measure(nm_txt)
            cv.create_text(hx + nm + 8, y + 12, anchor="w", text="· " + act_txt,
                           font=F_SMALL, fill=C_INK3, tags=(tag,))
        # 整块标题都是热区：左键 = 打开改名框，右键 = 小菜单。
        # 用户报的原话是「这种后面的立刻做这些应该是可以修改的才对」——
        # 点了没反应的地方，谁也不会去猜它能改，所以必须点得动。
        self.regions.append(("qhead", "Q%d" % pr["p"],
                             x + INNER - 2, y + 1, right_x, y + QHEAD - 3))

        if not items:
            cv.create_text(x + w / 2, y + QHEAD + (h - QHEAD) / 2,
                           text="把便利贴拖到这里" if self.mode == "matrix" else "暂无",
                           font=F_SMALL, fill="#c3bbad", tags=(tag,))
            return

        rhs = row_heights(shown, ncol)
        for i, t in enumerate(shown):
            r, c = divmod(i, ncol)
            cx = x + INNER + c * (cw + GAP)
            cy = y + QHEAD + INNER + sum(rhs[:r]) + r * GAP
            self._draw_card(t, cx, cy, cw)

    # -------- 单张卡片 --------
    def _draw_card(self, t, x, y, w):
        cv = self.cv
        pr = PRIO_BY_P[t["p"]]
        tag = "card%s" % t["id"]
        bg = C_DONE_BG if t["done"] else pr["bg"]
        x2, y2 = x + w, y + block_h(t)      # 高度随子任务条数变化

        # 命中测试是倒序查找：整张卡片作为兜底，必须最先登记，否则会盖住内部控件
        self.regions.append(("card", t["id"], x, y, x2, y2))

        # 阴影 + 主体
        cv.create_rectangle(x + 2, y + 3, x2 + 2, y2 + 3, fill=C_SHADOW, outline="", tags=(tag,))
        cv.create_rectangle(x, y, x2, y2, fill=bg, outline="#e7e1d6", width=1, tags=(tag,))
        # 顶部色带
        cv.create_rectangle(x + 1, y + 1, x2 - 1, y + 5,
                            fill=(C_LINE if t["done"] else pr["band"]), outline="", tags=(tag,))

        # 复选框
        bx, by = x + 13, y + 17
        bs = 15
        cv.create_rectangle(bx, by, bx + bs, by + bs, fill=C_WHITE,
                            outline=(C_INK3 if t["done"] else pr["band"]), width=2, tags=(tag,))
        if t["done"]:
            cv.create_rectangle(bx + 1, by + 1, bx + bs - 1, by + bs - 1,
                                fill=pr["band"], outline="", tags=(tag,))
            cv.create_line(bx + 3.5, by + 7.5, bx + 6.5, by + 10.5, bx + 11.5, by + 4.5,
                           fill="#ffffff", width=2, capstyle="round", joinstyle="round", tags=(tag,))

        self.regions.append(("chk", t["id"], bx - 4, by - 4, bx + bs + 4, by + bs + 4))

        # 重复标记：标题左边一个 18px 的小徽章。
        # 这里用 Canvas 画方块 + 一个字，而不是直接打 ↻ ——
        # 打符号要赌字体里有那个字形，缺了就是豆腐块；画方块永远稳。
        tx = bx + bs + 10
        rp = t.get("repeat") or ""
        if rp:
            rw = 18
            round_rect(cv, tx, y + 16, tx + rw, y + 16 + rw, 5,
                       fill=(C_LINE if t["done"] else pr["band"]),
                       outline="", tags=(tag,))
            cv.create_text(tx + rw / 2, y + 16 + rw / 2,
                           text=REPEAT_BADGE.get(rp, "循"), font=F_TINY,
                           fill="#ffffff", tags=(tag,))
            self.regions.append(("rep", t["id"], tx - 2, y + 14,
                                 tx + rw + 2, y + 18 + rw))
            tx += rw + 6

        # 标题（+ 右端的「创建 / 完成时间」）
        tw = (x2 - 13) - tx
        # 时间贴在标题第一行的右端，**不再单独占一行**（用户要的）；
        # 代价是标题的折行宽度要先把这块让出来 —— 跟 block_h() 里的 _title_w()
        # 是同一个式子，两边必须一起改。
        mtext = meta_line(t)
        mw = (_font_of(F_SMALL).measure(mtext) + META_INLINE_GAP) if mtext else 0
        lines = self._wrap(t["title"], F_TITLE, tw - mw, 2)
        ty = y + TITLE_TOP
        for ln in lines:
            cv.create_text(tx, ty, anchor="nw", text=ln, font=F_TITLE,
                           fill=(C_INK3 if t["done"] else C_INK), tags=(tag,))
            ty += LINE_TITLE
        if mtext:
            cv.create_text(x2 - 13, y + TITLE_TOP + 2, anchor="ne", text=mtext,
                           font=F_SMALL,
                           fill=("#a9a294" if t["done"] else C_INK3), tags=(tag,))
        if t["done"] and lines:
            fm = tkfont.Font(font=F_TITLE)
            for i, ln in enumerate(lines):
                ly = y + TITLE_TOP + i * LINE_TITLE + 8
                cv.create_line(tx, ly, tx + fm.measure(ln), ly, fill="#a8a196", tags=(tag,))
        self.regions.append(("title", t["id"], tx - 3, y + TITLE_TOP - 3,
                             tx + tw + 3, ty + 2))

        # 备注。**空备注也要占满一行**（画的是那行浅灰的「＋ 备注」），
        # 否则子任务区会直接从备注**顶**开始画，「子任务 x/y」就压在这行字上了。
        # ny 走完这一段必须等于 block_h() 里的 note_bottom —— 两边是一对。
        ny = ty + NOTE_GAP
        if t["note"]:
            nlines = self._wrap(t["note"], F_BODY, tw, 2)
            top = ny
            widest = 0
            for ln in nlines:
                cv.create_text(tx, ny, anchor="nw", text=ln, font=F_BODY,
                               fill="#8a8377", tags=(tag,))
                widest = max(widest, _font_of(F_BODY).measure(ln))
                ny += LINE_NOTE
            # 单击区域只覆盖**真正画出来的字**，不是整行宽度。卡片现在是按内容
            # 算高度的，矮卡片上"整行宽度"会横跨半张卡，点哪儿都被当成点了备注。
            self.regions.append(("note", t["id"], tx - 3, top - 2,
                                 tx + min(tw, widest) + 6, ny + 2))
        else:
            # 空备注：画一行浅灰的「＋ 备注」当入口。
            # 以前这里什么都不画，只登记了一条看不见的热区 —— 新建的任务
            # 卡片上没有任何能加备注的地方，等于按钮藏起来了，用户根本找不到。
            cv.create_text(tx, ny, anchor="nw", text=NOTE_EMPTY, font=F_BODY,
                           fill=NOTE_EMPTY_FG, tags=(tag,))
            # 同理：热区只包住这几个字，别让它铺满整行（它是个"按钮"）
            ew = _font_of(F_BODY).measure(NOTE_EMPTY)
            self.regions.append(("note", t["id"], tx - 3, ny - 2,
                                 tx + min(tw, ew) + 6, ny + LINE_NOTE))
            ny += LINE_NOTE          # ← 这一行就是"空备注也占一行"的全部秘密

        # 拖拽落点区：卡片**上半张**（标题 + 备注那一段）＝「变成它的子任务」。
        # 下半张（子任务 + 徽章行）和卡片之间的空隙仍然留给「插到第几位」，
        # 否则同组排序就没地方可放了。
        # 注意：卡片高度现在是按内容算的，"内容块 + NEST_PAD" 在矮卡片上会超过
        # 一半，所以再拿**卡片中线**封一次顶，保证下半张永远留得下排序落点。
        # 这里记的是画布坐标，拖拽时直接比即可
        # （拖拽过程中只有被拖那张卡在动，别人这份快照是准的）。
        self._nest_zone[t["id"]] = (x, y, x2, min(ny + NEST_PAD, (y + y2) / 2.0))

        # 子任务区（只有真的有子任务时才画；高度已在 block_h() 里预留）
        # 起点 = 备注**底** + SUB_PAD，和 block_h() 里的 sub_top 是同一个式子
        content_bottom = ny
        if subs_of(t):
            self._draw_subs(t, x, ny + SUB_PAD, w, pr, tag)

        # 底部分隔
        fy = y2 - FOOT_H
        cv.create_line(x + 12, fy, x2 - 12, fy, fill="#d8d2c6", dash=(3, 3), tags=(tag,))

        # ---- 徽章行：左边是优先级 + 日期，右边是计时器 ----
        ry = fy + 8
        coin_x = self._draw_timer(t, x2, ry, pr, tag)

        # 优先级徽章。备注可能被用户写得很长，裁一下 —— 这一行还要放日期
        # 和计时器，撑破了就会把计时器挤出卡片。
        label = _clip_text(quad_title(pr["p"]), F_TINY, 150)
        bw = tkfont.Font(font=F_TINY).measure(label) + 20
        px1 = x + 12
        round_rect(cv, px1, ry, px1 + bw, ry + 18, 9,
                   fill=(C_INK3 if t["done"] else pr["band"]), outline="", tags=(tag,))
        cv.create_text(px1 + bw / 2, ry + 9, text=label, font=F_TINY,
                       fill="#ffffff", tags=(tag,))
        self.regions.append(("prio", t["id"], px1, ry - 2, px1 + bw, ry + 20))

        # 截止日期：只有在「不跟计时器打架」时才画，否则宁可不画也不许溢出。
        # 已完成的任务不再需要「＋ 日期」这个入口，这个位置改放**用了多久** ——
        # 标题那行已经被两个精确时刻占满，放不下第三个数字了。
        dx = px1 + bw + 8
        if t["done"]:
            dtext, dcls = usage_text(t), "usage"
        else:
            dtext, dcls = self._due_text(t)
            if not dtext:
                dtext, dcls = "+ 日期", "empty"
        dwn = tkfont.Font(font=F_SMALL).measure(dtext) + 18
        if dtext and dx + dwn <= coin_x - 8:
            fill = {"overdue": "#ffd9d9", "today": "#fff0ce",
                    "soon": "#e4eeff", "empty": "#ffffff",
                    "usage": "#efeee7"}.get(dcls, "#ffffff")
            ink = {"overdue": "#b4242a", "today": "#8a5200",
                   "soon": "#2c5c9e", "empty": "#bdb6a9",
                   "usage": "#7d766a"}.get(dcls, C_INK2)
            round_rect(cv, dx, ry, dx + dwn, ry + 18, 9, fill=fill, outline="", tags=(tag,))
            cv.create_text(dx + dwn / 2, ry + 9, text=dtext, font=F_SMALL,
                           fill=ink, tags=(tag,))
            if not t["done"]:
                # 「用时」是纯展示，不做成按钮（点它开日期对话框只会让人困惑）
                self.regions.append(("due", t["id"], dx, ry - 2, dx + dwn, ry + 20))

    def _draw_subs(self, t, x, y, w, pr, tag):
        """画卡片里的子任务区。返回画完后的 y（方便以后往下面接着加东西）。

        画的是 visible_subs()：**未完成在前、已完成沉底、不是今天完成的不画**
        （跟 block_h 里按可见条数算高度是同一套判断）。收起的那几条不是没了 ——
        「子任务 x/y」右边有个「已完成 N」的胶囊，点一下临时摊开。
        """
        cv = self.cv
        subs = subs_of(t)
        n_all, done = len(subs), sub_done_n(t)
        vis = visible_subs(t)
        n_hid = n_all - len(vis)
        head = "子任务 %d/%d" % (done, n_all)

        cv.create_line(x + 12, y, x + w - 12, y, fill=C_SUB_SEP, tags=(tag,))
        y += SUB_PAD
        cv.create_text(x + 13, y, anchor="nw", text=head,
                       font=F_SUB, fill=C_INK3, tags=(tag,))

        # 右端先摆翻页器（贴边），它返回自己占的宽度，好让胶囊接着往左排
        pgs = sub_pages(len(vis))
        pg = self._sub_page(t["id"], pgs)
        pager_w = 0
        if pgs > 1:
            pager_w = self._draw_sub_pager(t, x + w - 11, y, pgs, pg, tag)

        # 翻页器左边：「已完成 N」胶囊。它是**摊开收起部分**的唯一入口 ——
        # 主任务有「已完成」筛选兜着，子任务没有第二层入口，收起来就再也点不到了。
        #
        # 注意判据是「有收起的 **或** 现在正摊着」：摊开之后 n_hid 变成 0，
        # 只看 n_hid 的话胶囊会当场消失 —— 那就再也收不回去了。
        is_open = t["id"] in SUB_SHOW_DONE
        if n_hid or is_open:
            lbl = "收起" if is_open else "已完成 %d" % n_hid
            cw = _font_of(F_SUB).measure(lbl) + 16
            cx2 = x + w - 11 - (pager_w + 4 if pager_w else 0)
            cx1 = cx2 - cw
            head_w = _font_of(F_SUB).measure(head)
            if cx1 > x + 13 + head_w + 8:          # 别和左边的标题挤在一起
                round_rect(cv, cx1, y - 2, cx2, y + SUB_HEAD - 1, 7,
                           fill="#efeadf", outline=C_LINE, width=1, tags=(tag,))
                cv.create_text((cx1 + cx2) / 2.0, y + SUB_HEAD / 2.0 - 3,
                               text=lbl, font=F_SUB, fill=C_INK2, tags=(tag,))
                self.regions.append(("subtos:" + t["id"], t["id"],
                                     cx1, y - 3, cx2, y + SUB_HEAD))
        y += SUB_HEAD

        for s in vis[pg * SUB_MAX:(pg + 1) * SUB_MAX]:
            sd = bool(s.get("done"))
            bx, by = x + 14, y + 1
            cv.create_rectangle(bx, by, bx + SUB_BOX, by + SUB_BOX, fill=C_WHITE,
                                outline=(pr["band"] if sd else C_SUB_MARK),
                                width=1, tags=(tag,))
            if sd:
                cv.create_line(bx + 2, by + SUB_BOX / 2, bx + 4.5, by + SUB_BOX - 3,
                               bx + SUB_BOX - 2, by + 2.5,
                               fill=pr["band"], width=2, capstyle="round",
                               joinstyle="round", tags=(tag,))
            self.regions.append(("sc:" + s["id"], t["id"],
                                 bx - 3, by - 3, bx + SUB_BOX + 3, by + SUB_BOX + 3))

            sx = bx + SUB_BOX + 6
            ln = self._wrap(s["text"], F_SUB, (x + w - 10) - sx, 1)
            txt = ln[0] if ln else ""
            cv.create_text(sx, y, anchor="nw", text=txt, font=F_SUB,
                           fill=(C_SUB_DONE if sd else C_INK2), tags=(tag,))
            if sd and txt:
                cv.create_line(sx, y + 8, sx + tkfont.Font(font=F_SUB).measure(txt), y + 8,
                               fill=C_SUB_DONE, tags=(tag,))
            self.regions.append(("st:" + s["id"], t["id"], sx - 3, y - 2, x + w - 8, y + 15))
            # 子任务行的 y 区间（按**显示顺序**）—— 子任务拖拽排序时用来算落点
            self._sub_rows.setdefault(t["id"], []).append((s["id"], y - 2, y + 13))
            y += SUB_LINE
        return y

    def _draw_sub_pager(self, t, xr, y, pgs, pg, tag):
        """在「子任务 x/y」那一行的右端画 ‹ 1/2 ›。**返回它占的宽度** ——
        调用方要在它左边接着摆「已完成 N」那个胶囊（那个得先知道这儿占了多少）。

        箭头是用 create_line 画的折线，不是 ‹ › 这两个字符 —— 字符要靠字体
        碰运气，缺字形就是豆腐块；折线永远画得出来（复选框的勾也是这么画的）。
        到头的那一侧画成浅灰（点了也原地不动，见 turn_sub_page）。
        """
        cv = self.cv
        lbl = "%d/%d" % (pg + 1, pgs)
        pw = max(24, _font_of(F_SUB).measure(lbl) + 6)
        n1, n2 = xr - SUB_PAGER, xr                 # 右端 = 下一页 ›
        t1, t2 = n1 - pw, n1                        # 中间 = 页码
        p1, p2 = t1 - SUB_PAGER, t1                 # 左端 = 上一页 ‹
        cy = y + SUB_HEAD / 2.0 - 1
        # 一整块浅底 + 细边，让它一眼就是个按钮（单摆两个小尖角太不起眼）
        round_rect(cv, p1 - 3, y - 3, n2 + 3, y + SUB_HEAD + 1, 7,
                   fill=C_WHITE, outline=C_LINE, width=1, tags=(tag,))

        cv.create_text((t1 + t2) / 2.0, y, anchor="n", text=lbl,
                       font=F_SUB, fill=C_INK3, tags=(tag,))
        # 折线的尖端朝哪边：a=-1 → 尖端在左（‹ 上一页）；a=+1 → 尖端在右（› 下一页）
        for (b1, b2, a, live, knd) in ((p1, p2, -1, pg > 0, "subprev"),
                                       (n1, n2, +1, pg < pgs - 1, "subnext")):
            cx = (b1 + b2) / 2.0
            ink = C_INK2 if live else "#c9c2b5"
            cv.create_line(cx - 3 * a, cy - 4, cx + 3 * a, cy, cx - 3 * a, cy + 4,
                           fill=ink, width=1.6, capstyle="round",
                           joinstyle="round", tags=(tag,))
            self.regions.append((knd, t["id"], b1 - 3, y - 4, b2 + 3, y + SUB_HEAD + 2))
        return (n2 + 3) - (p1 - 3)

    def _sub_page(self, tid, pgs):
        """这张卡当前翻到第几页（0 起）。**越界一律夹回合法范围再返回** ——
        子任务被删掉几条之后，存在内存里的页码会指到不存在的页上去。"""
        pg = int(self.sub_page.get(tid) or 0)
        pg = max(0, min(pg, pgs - 1))
        self.sub_page[tid] = pg
        return pg

    def _sub_page_base(self, tid):
        """当前页第一条子任务在**整个可见序列**里的下标。

        子任务拖拽的落点算的是"屏幕上的第几行"，落库要的是列表下标 ——
        中间隔着两层：① 翻页（第二页的第一行其实是可见序列里的第 SUB_MAX 条）；
        ② "可见序列"本身是 reorder + 过滤过的（未完成在前、次日收起的没画）。
        所以每次都要先按**可见条数**把页码夹回合法范围（收起几条之后页码会越界）。
        """
        t = self.task_by_id(tid)
        pgs = sub_pages(len(visible_subs(t))) if t else 1
        return self._sub_page(tid, pgs) * SUB_MAX

    def _sub_row_of(self, tid, idx):
        """列表下标 → **当前这一页里的第几行**（_sub_insert_index 的逆运算）。

        落到看不见的那条（已收起的已完成）或者越界时，一律当作"本页末尾"。
        """
        rows = self._sub_rows.get(tid) or []
        t = self.task_by_id(tid)
        if not t:
            return len(rows)
        vis, subs = visible_subs(t), subs_of(t)
        try:
            k = vis.index(subs[int(idx)])
        except (ValueError, IndexError):
            return len(rows)
        return max(0, min(k - self._sub_page_base(tid), len(rows)))

    def turn_sub_page(self, t, d):
        """翻一页子任务（d = -1 上一页 / +1 下一页）。到头了就停住，不循环。

        页数按**可见条数**算 —— 已收起的已完成条目不参与分页（跟 block_h
        和 _draw_subs 用的是同一个 visible_subs）。
        """
        pgs = sub_pages(len(visible_subs(t)))
        if pgs <= 1:
            return
        old = self._sub_page(t["id"], pgs)
        new = max(0, min(old + d, pgs - 1))
        if new == old:
            return
        self.sub_page[t["id"]] = new
        self.redraw()

    def _draw_timer(self, t, x2, y, pr, tag):
        """画右下角的计时药丸：点它就切换计时（见 handle_click 的 timer 分支）。
        返回它的左边界 x，好让左边的日期徽章知道还剩多少空间。"""
        cv = self.cv
        sec = spent_of(t)
        run = bool(t.get("timer"))
        txt = fmt_dur(sec) if (sec > 0 or run) else "计时"
        fw = tkfont.Font(font=F_TINY).measure(txt)
        # 圆点只在「正在计时」时出现，表示"在录"。不加别的小圆点 ——
        # 空心圈挨着数字会被误读成 0，比如「01时15分」。
        w = 6 + (9 if run else 0) + fw + 7
        x1 = x2 - 12 - w

        if run:
            bg, ink = pr["band"], "#ffffff"
        elif sec > 0:
            bg, ink = C_TIME_HAS, C_TIME_INK
        else:
            bg, ink = C_TIME_IDLE, C_INK3
        round_rect(cv, x1, y, x1 + w, y + 18, 9, fill=bg,
                   outline=("" if run or sec > 0 else C_LINE), width=1, tags=(tag,))
        if run:
            cv.create_oval(x1 + 6, y + 6, x1 + 12, y + 12, fill="#ffffff",
                           outline="", tags=(tag,))
        cv.create_text(x1 + 6 + (9 if run else 0), y + 9, anchor="w",
                       text=txt, font=F_TINY, fill=ink, tags=(tag,))
        self.regions.append(("timer", t["id"], x1 - 3, y - 3, x1 + w + 3, y + 21))
        return x1

    def _due_text(self, t):
        """卡片底部那颗日期药丸写什么。返回 ("", "") 表示没设日期（或已完成）。

        带时刻的会把时刻一起写出来（「今天 18:30」「10/15 18:30:05」），
        而"逾期"按**时间点**判：今天 09:00 的活，15:00 就该红。
        """
        if t["done"] or not t["due"]:
            return "", ""
        d = s2d(t["due"])
        if not d:
            return "", ""
        dt = parse_dt(t["due"])
        clock = ""
        if dt and due_has_time(t["due"]):
            clock = " %02d:%02d" % (dt.hour, dt.minute)
            if dt.second:                       # 秒是用户自己填的才写出来
                clock += ":%02d" % dt.second
        delta = (d - today()).days
        if is_overdue(t):
            if delta == 0:
                # 今天已经过了那个时刻：说「已过 2 小时」比说「今天」有用得多
                mins = int((datetime.datetime.now() - dt).total_seconds() // 60)
                if mins < 60:
                    return "已过 %d 分钟" % max(1, mins), "overdue"
                return "已过 %d 小时" % (mins // 60), "overdue"
            return "逾期 %d 天" % (-delta), "overdue"
        if delta == 0:
            return ("今天" + clock) if clock else "今天", "today"
        if delta == 1:
            return ("明天" + clock) if clock else "明天", "soon"
        if delta <= 7:
            return ("%d 天后" % delta) + clock, "soon"
        return d.strftime("%m/%d") + clock, ""

    def _wrap(self, text, font, maxw, maxlines):
        """按像素宽度折行。**规则本体在模块级 _wrap_lines**，这里只是转一下 ——
        绘制和 block_h() 算卡片高度必须共用同一套，见机制⑪。"""
        return _wrap_lines(text, font, maxw, maxlines)

    def _update_stats(self):
        """刷新状态栏右侧那排胶囊。

        它们既是统计数字，也是**切筛选的入口**（点一下就切，见 chip_filter）。
        所以这里只负责把文字和显隐填对，样式交给 _chip_paint。
        """
        T = today()
        all_ = self.tasks
        open_ = [t for t in all_ if not t["done"]]
        hot = [t for t in open_ if t["due"] and s2d(t["due"]) and s2d(t["due"]) <= T]
        late = [t for t in open_ if is_overdue(t)]
        run = [t for t in open_ if t.get("timer")]
        arch = len(self.archived_done())

        vals = {
            "open":    (len(open_), ""),
            "due":     (len(hot), ""),
            "overdue": (len(late), ""),
            "running": (len(run), ""),
            # 「已完成 N」的 N 是**全部**完成的任务；括号里是其中已经从板面
            # 收起的那部分。写成括号而不是并列的「· 归档 N」——
            # 并列会让人以为是两批不同的任务（用户就是这么被绕进去的）。
            "done":    (len(all_) - len(open_),
                        "（收起%d）" % arch if arch else ""),
        }
        for k, label in STAT_CHIPS:
            lab = self.stat_chips.get(k)
            if lab is None:
                continue
            n, extra = vals[k]
            if k != "done" and not n:
                lab.grid_remove()        # 为 0 的项不占地方（已完成永远显示）
            else:
                # 数字跟汉字之间不留空格：这排胶囊是抢宽度的大户，
                # 中文里「未完成5」读起来也不别扭
                lab.configure(text="%s%d%s" % (label, n, extra))
                lab.grid()
                self._chip_paint(k)

    # ============================================================ 命中测试

    def hit(self, cx, cy):
        for kind, tid, x1, y1, x2, y2 in reversed(self.regions):
            if x1 <= cx <= x2 and y1 <= cy <= y2:
                return kind, tid
        return None, None

    def task_by_id(self, tid):
        for t in self.tasks:
            if t["id"] == tid:
                return t
        return None

    def _canvas_xy(self, e):
        return self.cv.canvasx(e.x), self.cv.canvasy(e.y)

    # ============================================================ 鼠标事件

    def on_press(self, e):
        # 若正在就地编辑，先把内容落盘，再继续处理这次点击
        if self.editor:
            self._commit_editor()
        cx, cy = self._canvas_xy(e)
        kind, tid = self.hit(cx, cy)
        # 板面空态里那个「回到全部」、象限标题栏上的翻页器、象限标题本身
        # （点了改名），都不是任务：单独给它们一条最小 drag，松手时不拖动就
        # 走 on_release → handle_click，和别的可点区域同一条路径。
        # 标记 fixed 是为了不让它们参与拖拽。
        #
        # ★ tid 必须**原样带上**。象限翻页器的 tid 是 "Q1" 这种（不是任务 id），
        #   handle_click 靠它判断翻哪个象限 —— 写成空串的话点了会静默没反应
        #   （2026-10-24 就是这么翻车一次的）。空态那个的 tid 本来就是 ""。
        if kind in ("emptyreset", "qprev", "qnext", "qhead"):
            self.drag = {"tid": tid, "x0": cx, "y0": cy, "kind": kind,
                         "moved": False, "target": None, "idx": None,
                         "nest": None, "last_x": cx, "last_y": cy, "fixed": True}
            return
        if not tid:
            return
        t = self.task_by_id(tid)
        if not t:
            return
        # 子任务那一行也能拖：上下拖 = 调它在卡片里的顺序，拖到别的卡片上 = 搬过去。
        # 没拖动就松手仍然走原来的单击逻辑（勾选 / 不做事），见 on_release。
        if kind and (kind.startswith("sc:") or kind.startswith("st:")):
            sid = kind[3:]
            if sub_by_id(t, sid):
                self.drag = {"sub": True, "tid": tid, "sid": sid, "kind": kind,
                             "x0": cx, "y0": cy, "moved": False,
                             "target": tid, "idx": None, "promote": None,
                             "last_x": cx, "last_y": cy}
                return
        self.drag = {"tid": tid, "x0": cx, "y0": cy, "kind": kind,
                     "moved": False, "target": t["p"], "start_p": t["p"],
                     "idx": None, "nest": None, "last_x": cx, "last_y": cy}

    def on_motion(self, e):
        d = self.drag
        if not d:
            return
        if d.get("fixed"):
            return                  # 空态提示上的按钮，不参与拖拽
        cx, cy = self._canvas_xy(e)

        if not d["moved"]:
            if abs(cx - d["x0"]) < DRAG_TOL and abs(cy - d["y0"]) < DRAG_TOL:
                d["last_x"], d["last_y"] = cx, cy
                return
            d["moved"] = True
            if d.get("sub"):
                self.status.configure(text=SUB_DRAG_HINT)
            else:
                self.cv.tag_raise("card" + d["tid"])
                self.status.configure(text=DRAG_HINT)

        if d.get("sub"):
            self._motion_sub(d, cx, cy)
            return

        dx, dy = cx - d["last_x"], cy - d["last_y"]
        d["last_x"], d["last_y"] = cx, cy

        self.cv.move("card" + d["tid"], dx, dy)
        self.cv.tag_raise("card" + d["tid"])

        # 落到别人卡片的**上半张** → 变成它的子任务（优先于排序落点）
        nest = self._nest_at(cx, cy, d["tid"])
        if nest:
            if d.get("nest") != nest:
                d["nest"], d["target"], d["idx"] = nest, None, None
                self._show_nest(nest)
            return
        d["nest"] = None

        # 既要判断"落到哪个象限"，也要判断"插到第几位"
        prev_p, prev_i = d["target"], d["idx"]
        tgt_p = self._quad_at(cx, cy, prev_p if prev_p is not None else d["start_p"])
        tgt_i = self._insert_index(tgt_p, cx, cy, d["tid"])
        if (tgt_p, tgt_i) != (prev_p, prev_i):
            d["target"], d["idx"] = tgt_p, tgt_i
            self._show_target(tgt_p, tgt_i)
            self.cv.tag_raise("card" + d["tid"])

    def on_release(self, e):
        d, self.drag = self.drag, None
        if not d:
            return
        self.cv.delete("hl")
        if not d["moved"]:
            self.handle_click(d["kind"], d["tid"], e)
            return
        if not self._undo_cb:            # 撤销提示还挂着的时候别把它顶掉
            self.status.configure(text=HINT_TEXT)

        if d.get("sub"):
            self._drop_sub(d)
            return

        t = self.task_by_id(d["tid"])
        if not t:
            self.redraw()
            return
        if d.get("nest"):
            tgt = self.task_by_id(d["nest"])
            self.redraw()                # 先把被拖走的卡片放回去，再谈嵌套
            if tgt:
                self.nest_task(t, tgt)
            return
        idx = d["idx"]
        if idx is None:                  # 没移动够距离就松手，落到该象限末尾
            idx = len([x for x in self.tasks
                       if x["p"] == d["target"] and x["id"] != t["id"]])
        self._apply_drop(t, d["target"], idx)
        self.save()
        self.redraw()

    def _card_region(self, tid):
        """某张卡片当前画在哪。取自 regions 快照 —— 拖拽过程中其他卡片没动，
        所以这份坐标是准的（被拖那张要先排除掉，见 _insert_index）。"""
        for kind, i, x1, y1, x2, y2 in self.regions:
            if kind == "card" and i == tid:
                return (x1, y1, x2, y2)
        return None

    def _insert_index(self, p, cx, cy, exclude_id):
        """落点若要落在象限 p，应该插到第几位。

        做法：把该象限的卡片按显示顺序排好，逐个和落点比 ——
        落点在卡片上方 → 插到它前面；纵向落在它身上 → 再比左右。
        合起来就是「按阅读顺序，找第一张排在落点后面的卡片」。"""
        items = sorted([t for t in self.tasks
                        if t["p"] == p and t["id"] != exclude_id],
                       key=self.sort_key)
        last = None
        for i, t in enumerate(items):
            r = self._card_region(t["id"])
            if not r:
                continue
            last = i
            x1, y1, x2, y2 = r
            if cy < y1:
                return i
            if cy <= y2 and cx < (x1 + x2) / 2:
                return i
        # 落在**画出来的最后一张**下面 → 插到它后面。
        # 不能直接 return len(items)：封顶分页之后，后面的卡片根本没画出来，
        # 用户看不见，落点也就该落在本页末尾，而不是整列末尾。
        return (last + 1) if last is not None else len(items)

    def _apply_drop(self, t, p, idx):
        """把任务 t 落到象限 p 的第 idx 位，然后给这个象限重新编号。

        编号规则：未完成的按新顺序排在前面，已完成的按原顺序沉底 ——
        这样「完成即沉底」的既有行为不会被手动排序破坏。"""
        t["p"] = p
        others = [x for x in self.tasks if x["p"] == p and x["id"] != t["id"]]
        opens = sorted([x for x in others if not x["done"]], key=lambda x: x["order"])
        dones = sorted([x for x in others if x["done"]], key=lambda x: x["order"])
        idx = max(0, min(int(idx), len(opens)))
        if t["done"]:
            seq = opens + dones + [t]          # 已完成的任务只能垫底
        else:
            seq = opens[:idx] + [t] + opens[idx:] + dones
        for i, x in enumerate(seq):
            x["order"] = float(i)

    def _quad_at(self, cx, cy, fallback):
        """根据坐标判断落在哪个象限；找不到则沿用当前。"""
        coords = self._quad_rects
        for p, (x, y, w, h) in coords.items():
            if x <= cx <= x + w and y <= cy <= y + h:
                return p
        # 横向仍在本列、纵向落在象限之间的缝隙时，取最近的一个
        best, bd = fallback, 1e9
        for p, (x, y, w, h) in coords.items():
            if x - 30 <= cx <= x + w + 30:
                d = min(abs(cy - y), abs(cy - (y + h)))
                if d < bd:
                    best, bd = p, d
        return best

    def _show_target(self, p, idx=None):
        """拖拽落点提示（只画辅助线，不重绘整块画布，免得打断拖拽）。

        跨象限：给目标象限描一圈虚线框，表示"会换到这一类"。
        同象限：在将要插入的位置画一条竖线，表示"会插到这里"。"""
        self.cv.delete("hl")
        if not self._quad_rects.get(p):
            return
        if self.drag and p == self.drag.get("start_p"):
            self._draw_insert_line(p, idx, self.drag["tid"])
            return
        x, y, w, h = self._quad_rects[p]
        self.cv.create_rectangle(x + 2, y + 2, x + w - 2, y + h - 2,
                                 outline=PRIO_BY_P[p]["band"], width=2,
                                 dash=(7, 5), tags="hl")
        # 抬到该象限背景之上，但仍位于卡片之下
        self.cv.tag_raise("hl", "qbg%d" % p)

    def _draw_insert_line(self, p, idx, exclude_id):
        """同象限排序时，在将要插入的位置画一条竖线。

        exclude_id 是要从这一列里排除掉的任务（卡片拖拽时就是被拖那张 ——
        它正悬在半空，坐标不算数）。子任务提升成独立任务时传 None，
        因为那时候画布上所有卡片都是老老实实待在原位的。"""
        items = sorted([t for t in self.tasks
                        if t["p"] == p and t["id"] != exclude_id],
                       key=self.sort_key)
        if not items:
            return
        idx = 0 if idx is None else max(0, min(int(idx), len(items)))
        if idx < len(items):
            r = self._card_region(items[idx]["id"])
            lx = (r[0] - 6) if r else None
        else:
            r = self._card_region(items[-1]["id"])
            lx = (r[2] + 6) if r else None
        if not r or lx is None:
            return
        self.cv.create_line(lx, r[1], lx, r[3], fill=PRIO_BY_P[p]["band"],
                            width=3, capstyle="round", tags="hl")

    # -------- 拖拽：变成子任务 / 子任务排序 --------

    def _nest_at(self, cx, cy, exclude_id):
        """落点是否压在别人卡片的「上半张」；是就返回那张卡片的 id。

        只认上半张（标题 + 备注那一段），下半张和卡片之间的空隙仍然归「插到第几位」——
        两件事挤在同一块画布上，只能靠几何分工。判定区在 _draw_card 里记进
        self._nest_zone（拖拽时只有被拖那张卡在动，别人这份快照是准的）。
        """
        for tid, (x1, y1, x2, y2) in self._nest_zone.items():
            if tid == exclude_id:
                continue
            if x1 <= cx <= x2 and y1 <= cy <= y2:
                return tid
        return None

    def _card_under(self, cx, cy, exclude=None):
        """落点在哪张卡片上（整张卡片，不分上下半张）。子任务拖拽用。"""
        for kind, tid, x1, y1, x2, y2 in self.regions:
            if kind != "card" or tid == exclude:
                continue
            if x1 <= cx <= x2 and y1 <= cy <= y2:
                return tid
        return None

    def _show_nest(self, tid):
        """拖拽提示：目标卡片描一圈实线，上半张盖一层网点（假装半透明）。"""
        self.cv.delete("hl")
        t = self.task_by_id(tid)
        zone = self._nest_zone.get(tid)
        r = self._card_region(tid)
        if not t or not zone or not r:
            return
        band = PRIO_BY_P[t["p"]]["band"]
        self.cv.create_rectangle(r[0] + 1, r[1] + 1, r[2] - 1, r[3] - 1,
                                 outline=band, width=2, tags="hl")
        # tkinter 画不了半透明，用 stipple 网点凑一个「淡淡地刷了一层」的效果。
        # gray12 就够了：gray25 太密，压在标题文字上会有点糊。
        self.cv.create_rectangle(zone[0] + 1, zone[1] + 1, zone[2] - 1, zone[3],
                                 fill=band, stipple="gray12", outline="", tags="hl")
        self.cv.tag_raise("hl")
        # 被拖的那张卡片要浮在最上面 —— 不然网点会盖在它脸上
        if self.drag:
            self.cv.tag_raise("card" + self.drag["tid"])
        self.status.configure(text="松手：把这张卡片变成「%s」的子任务"
                                   % ellipsis(t["title"], 12))

    def _sub_insert_index(self, tid, cy):
        """子任务拖拽：落点该插到**整个列表**的第几位。

        返回的是"插到某条**之前**"的列表下标（不是屏幕上的第几行）——
        屏幕上画的是 visible_subs()，中间隔着翻页和"未完成在前+次日收起"
        两层折算，所以必须走 _sub_page_base 把"本页第几行"还原成列表下标。
        """
        t = self.task_by_id(tid)
        rows = self._sub_rows.get(tid) or []
        if not t:
            return 0
        vis, subs = visible_subs(t), subs_of(t)
        base = self._sub_page_base(tid)

        def to_idx(k):
            return subs.index(vis[k]) if k < len(vis) else len(subs)

        for i, (_sid, y1, y2) in enumerate(rows):
            if cy < (y1 + y2) / 2.0:
                return to_idx(base + i)
        return to_idx(base + len(rows))

    def _motion_sub(self, d, cx, cy):
        """子任务拖拽：不真的搬行，只画辅助线；松手才落库。

        两种落点：压在卡片上 = 搬进那张卡（或在本卡里调顺序）；
        落在卡片以外的空白 = 提升成独立任务，落进鼠标所在的那个象限。
        """
        tgt = self._card_under(cx, cy)
        if tgt is None and self._in_board(cy):
            p = self._quad_at(cx, cy, None)
            if p is not None:
                d["promote"] = p
                d["target"], d["idx"] = None, None
                self._show_promote(d, p, cx, cy)
                return
        if tgt is None:
            # 不在卡片上、也不在某个象限里（板子外面 / 顶栏、状态栏上）：
            # 当作还在原卡里 —— 白拖一场，总比"莫名其妙多出一张卡"安全
            tgt = d["tid"]
        if d.get("promote") is not None:
            self.status.configure(text=SUB_DRAG_HINT)   # 从"提升"模式退回来
        d["promote"] = None
        idx = self._sub_insert_index(tgt, cy)
        d["target"], d["idx"] = tgt, idx
        self._show_sub_target(d, tgt, idx)

    def _in_board(self, cy):
        """落点还在不在四象限那块板子里（上下各给一点余量）。

        拖拽时鼠标可能被甩到顶栏 / 状态栏上 —— 那里不该被当成"拖到了某个
        象限的空白处"，否则一松手就冒出一张新卡片。判定就用现有象限矩形
        的上下边界，不额外依赖画布控件的几何。"""
        if not self._quad_rects:
            return False
        tops = [y for (_x, y, _w, _h) in self._quad_rects.values()]
        bots = [y + h for (_x, y, _w, h) in self._quad_rects.values()]
        return min(tops) - 4 <= cy <= max(bots) + 4

    def _show_promote(self, d, p, cx, cy):
        """子任务落到空白处的提示：给目标象限描虚线框 + 在插入位置画一条竖线。

        视觉上跟"把整张卡片拖到这个象限"是同一套语言，用户一眼能看出
        "松手会多出一张独立卡片"。"""
        self.cv.delete("hl")
        if not self._quad_rects.get(p):
            return
        x, y, w, h = self._quad_rects[p]
        band = PRIO_BY_P[p]["band"]
        self.cv.create_rectangle(x + 2, y + 2, x + w - 2, y + h - 2,
                                 outline=band, width=2, dash=(7, 5), tags="hl")
        self.cv.tag_raise("hl", "qbg%d" % p)
        # 被拖的那条子任务还在原卡里躺着（没有跟着鼠标飘），所以谁也不用排除
        self._draw_insert_line(p, self._insert_index(p, cx, cy, None), None)
        self.status.configure(text="松手：把这条子任务提升成独立任务 → %s"
                                   % quad_title(p))

    def _show_sub_target(self, d, tid, idx):
        """画两样东西：被拖那一行的虚线框（搬的是它）+ 落点那条横线。"""
        self.cv.delete("hl")
        r0 = self._card_region(d["tid"])
        if r0:
            for sid, y1, y2 in (self._sub_rows.get(d["tid"]) or []):
                if sid == d["sid"]:
                    self.cv.create_rectangle(r0[0] + 10, y1, r0[2] - 10, y2,
                                             outline="#9c9384", width=1,
                                             dash=(3, 3), tags="hl")
                    break
        r = self._card_region(tid)
        if not r:
            return
        t = self.task_by_id(tid)
        band = PRIO_BY_P[t["p"]]["band"] if t else "#9c9384"
        rows = self._sub_rows.get(tid) or []
        if rows:
            # idx 是列表下标，画线要看它是**当前这一页里的第几行**
            # （中间隔着翻页和"未完成在前 + 次日收起"两层折算）
            i = self._sub_row_of(tid, idx)
            ly = rows[i][1] - 1 if i < len(rows) else rows[-1][2] + 1
            self.cv.create_line(r[0] + 14, ly, r[2] - 14, ly,
                                fill=band, width=3, capstyle="round", tags="hl")
        else:
            # 目标卡片还没有子任务 —— 描一圈，表示「会在这张卡里新建一行」
            self.cv.create_rectangle(r[0] + 1, r[1] + 1, r[2] - 1, r[3] - 1,
                                     outline=band, width=2, tags="hl")
        if t and t["id"] != d["tid"]:
            self.status.configure(text="松手：把这条子任务挪到「%s」"
                                       % ellipsis(t["title"], 12))

    def _drop_sub(self, d):
        """子任务松手：在源卡片里摘掉、插到目标卡片（或同一张卡的另一处）；
        落点在卡片以外的空白时走提升，变成一张独立任务。"""
        src = self.task_by_id(d["tid"])
        sub = sub_by_id(src, d["sid"]) if src else None
        if not src or not sub:
            self.redraw()
            return
        if d.get("promote") is not None:
            self._promote_drop(src, sub, d)
            return
        tgt = self.task_by_id(d["target"]) if d["target"] else None
        if not tgt:
            tgt = src
        src_subs = subs_of(src)
        dst_subs = subs_of(tgt)
        old = src_subs.index(sub)
        idx = len(dst_subs) if d["idx"] is None else int(d["idx"])
        idx = max(0, min(idx, len(dst_subs)))
        if src is tgt:
            if old < idx:
                idx -= 1                        # 先摘后插，下标要往回收一格
            if idx == old:
                self.redraw()                   # 位置没变，白拖一场
                return
        snap = self._snapshot()
        src_subs.pop(old)
        dst_subs.insert(idx, sub)
        self.save()
        self.redraw()
        if src is tgt:
            self._flash_undo("子任务顺序已调整", lambda: self._restore_snapshot(snap))
        else:
            self._flash_undo("已把子任务「%s」挪到「%s」"
                             % (ellipsis(sub["text"], 8), ellipsis(tgt["title"], 10)),
                             lambda: self._restore_snapshot(snap))

    def _promote_drop(self, src, sub, d):
        """子任务拖到卡片以外的空白：提升成独立任务，落进鼠标所在的那个象限。

        和右键菜单里的 promote_sub 是同一件事，区别在位置 —— 拖拽版按落点算，
        菜单版固定"紧跟父任务后面"。子任务身上没有备注 / 计时 / 重复这些字段，
        所以这次搬运不会丢任何东西，直接做、给撤销入口就够了。
        """
        p = d["promote"]
        # 落点位置要在改动之前量好：源卡片摘掉一条子任务后会变矮，
        # 之后卡片会重新排布，那时候再算就对不上了。
        idx = self._insert_index(p, d["last_x"], d["last_y"], None)
        snap = self._snapshot()
        done = bool(sub.get("done"))
        nt = {"id": new_id(), "title": sub["text"], "note": "", "p": p,
              "due": "", "done": done, "order": now_ts(),
              "subs": [], "logs": {}, "timer": 0, "repeat": "",
              "done_at": now_ts() if done else 0,
              # 子任务本身不记时间（结构里只有 id/text/done），提升上来的
              # 只能从"现在"算起 —— 卡片上显示的创建时间会晚于它真实的诞生，
              # 这是已知的、可接受的偏差。
              "created_at": now_ts(), "remind_key": ""}
        subs_of(src).remove(sub)
        self.tasks.append(nt)
        self._apply_drop(nt, p, idx)      # 顺便把那个象限重新编号
        self.save()
        self.redraw()
        self._flash_undo("已把子任务「%s」提升成独立任务（%s）"
                         % (ellipsis(nt["title"], 8), quad_title(p)),
                         lambda: self._restore_snapshot(snap))
        return nt

    def handle_click(self, kind, tid, e):
        if kind == "emptyreset":
            # 板面空态里那个「回到全部 / 清空搜索」（它没有对应的任务）
            self.clear_filters()
            return
        if kind in ("qprev", "qnext"):
            # 象限标题栏上的翻页器：tid 是 "Q0".."Q3"（不是任务 id）
            try:
                p = int(str(tid)[1:])
            except (TypeError, ValueError):
                return
            self.turn_quad_page(p, -1 if kind == "qprev" else +1)
            return
        if kind == "qhead":
            # 象限标题（色点 + 名字 + 备注）本身就是「改名字」的入口。
            # 没有它，用户只能靠右键去猜 —— 而"点了没反应的地方能改"这件事，
            # 没人猜得到（这次报的 bug 正是这个形状）。
            try:
                self.ask_quads(int(str(tid)[1:]))
            except (TypeError, ValueError):
                self.ask_quads()
        t = self.task_by_id(tid)
        if not t:
            return
        if kind == "chk":
            self.toggle_done(t)
        elif kind == "prio":
            self.popup_prio(t, e)
        elif kind == "due":
            self.ask_due(t)
        elif kind == "timer":
            self.toggle_timer(t)
        elif kind == "rep":
            self.popup_repeat(t, e)
        elif kind == "note":
            # 备注是空的：卡片上那行「＋ 备注」当按钮用，单击直接弹编辑框
            # （光标预置在备注那栏）。已经有备注就不再抢单击了 —— 那一块归
            # 双击就地编辑。
            if not t["note"]:
                self.ask_edit(t, focus="note")
        elif kind and kind.startswith("sc:"):
            self.toggle_sub(t, kind[3:])
        elif kind == "subprev":
            self.turn_sub_page(t, -1)
        elif kind == "subnext":
            self.turn_sub_page(t, +1)
        elif kind and kind.startswith("subtos:"):
            # 「已完成 N」胶囊：摊开 / 收起那几条次日自动藏起来的已完成子任务
            self.toggle_sub_done_view(t)
        # kind == "st:xxx" 是子任务文字：单击不做事，留给双击去编辑

    def on_double(self, e):
        cx, cy = self._canvas_xy(e)
        kind, tid = self.hit(cx, cy)
        if not kind:
            return
        # 子任务的文字区域用 "st:<子任务id>" 作为类型去找，见 open_editor
        if kind in ("title", "note") or kind.startswith("st:"):
            t = self.task_by_id(tid)
            if t:
                # 【必须等这次双击事件彻底走完，再建那个输入框】
                # 双击的第二次「按下」会同时发出 <Button-1> 和 <Double-Button-1>。
                # 在这里就把输入框建好的话，同一次按下还会继续沿着 bindtags 走到
                # root 上那条 <Button-1>（_maybe_commit_editor：点别处就提交），
                # 而那一刻输入框刚 create_window、X 窗口还没映射，
                # winfo_containing 查到的仍然是画布 —— 于是被判成"点到了别处"，
                # 当场提交：编辑器一闪就没，看着像双击没反应，焦点还会掉回新增输入框。
                # 甩到下一轮空闲（after_idle）再建，这次事件就再也碰不到它了。
                self.root.after_idle(lambda: self.open_editor(t, kind))

    def on_hover(self, e):
        cx, cy = self._canvas_xy(e)
        kind, tid = self.hit(cx, cy)
        self.cv.configure(cursor="hand2"
                          if (tid or kind in ("emptyreset", "qprev", "qnext"))
                          else "")

    def on_right(self, e):
        cx, cy = self._canvas_xy(e)
        kind, tid = self.hit(cx, cy)
        if kind == "qhead":
            # 右键象限标题：只关于这一个象限的两件事（改名 / 恢复默认）
            try:
                p = int(str(tid)[1:])
            except (TypeError, ValueError):
                return
            self._popup(self.build_quad_menu(p), x=e.x_root, y=e.y_root)
            return
        t = self.task_by_id(tid) if tid else None
        if not t:
            self.show_canvas_menu(e)        # 点在空白处
            return
        # 点在子任务那一行上，弹子任务自己的菜单
        if kind and (kind.startswith("sc:") or kind.startswith("st:")):
            m = self.build_sub_menu(t, kind[3:])
            if m:
                self._popup(m, x=e.x_root, y=e.y_root)
                return
        # 其余一律是整卡菜单 —— 卡片上任何位置右键都走得到这里，
        # 所以「添加子任务…」在哪儿都点得到（见 build_sub_menu 里的注释）
        self._popup(self.build_card_menu(t), x=e.x_root, y=e.y_root)

    def build_sub_menu(self, t, sid):
        """子任务右键菜单。**拆成独立方法是为了能被测试直接调用**（同 build_more_menu）：
        菜单一旦弹出就进了模态循环，测试没法验它里面到底有没有哪几项。

        没有这条子任务时返回 None，调用方会退回到整卡菜单。
        """
        if not sub_by_id(t, sid):
            return None
        subs = subs_of(t)
        i = next((k for k, x in enumerate(subs) if x["id"] == sid), 0)
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        m.add_command(label="编辑文字…",
                      command=lambda: self.open_editor(t, "st:" + sid))
        m.add_command(label="标记完成 / 取消",
                      command=lambda: self.toggle_sub(t, sid))
        # 「添加子任务」在这里也要有 —— 子任务行铺满卡片时，卡面上压根没有
        # "空白处"可点；只在整卡菜单里放它，这块就成了唯一进不去的死角
        # （用户报的就是"在子任务处右键看不到添加子任务"）。
        # 现在卡片上任何位置右键，都能进「添加子任务」。
        m.add_command(label="添加子任务…", command=lambda: self.ask_add_sub(t))
        m.add_separator()
        # 已经在头 / 尾的那一条，对应的方向就没得移了
        m.add_command(label="上移", state=("normal" if i > 0 else "disabled"),
                      command=lambda: self.move_sub(t, sid, -1))
        m.add_command(label="下移",
                      state=("normal" if i < len(subs) - 1 else "disabled"),
                      command=lambda: self.move_sub(t, sid, +1))
        m.add_command(label="提升成独立任务",
                      command=lambda: self.promote_sub(t, sid))
        m.add_separator()
        m.add_command(label="删除这条子任务", command=lambda: self.del_sub(t, sid))
        return m

    def build_card_menu(self, t):
        """整卡右键菜单（拆分理由同 build_sub_menu）。"""
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        # 「编辑任务」放最前面：改标题（错别字）/ 备注是这条任务自己的内容，
        # 和标题一样属于「第一层」信息，也是最高频的操作。
        # 备注的编辑并进这个对话框了，菜单里只留一个「删除备注」的快手。
        m.add_command(label="编辑任务…", command=lambda: self.ask_edit(t))
        if t["note"]:
            m.add_command(label="删除备注", command=lambda: self.del_note(t))
        m.add_separator()
        sub = tk.Menu(m, tearoff=0, font=F_SMALL)
        for pr in PRIOS:
            sub.add_command(label=quad_full(pr["p"]),
                            command=lambda i=pr["p"]: self.set_prio(t, i))
        m.add_cascade(label="改优先级", menu=sub)
        m.add_command(label="设置截止日期…", command=lambda: self.ask_due(t))
        m.add_command(label="清除截止日期", command=lambda: self.set_due(t, ""))

        rsub = tk.Menu(m, tearoff=0, font=F_SMALL)
        for k, label, _badge in REPEATS:
            rsub.add_command(
                label=("● " if (t.get("repeat") or "") == k else "    ") + label,
                command=lambda kk=k: self.set_repeat(t, kk))
        m.add_cascade(label="重复：%s" % REPEAT_LABEL.get(t.get("repeat") or "", "不重复"),
                      menu=rsub)

        m.add_separator()
        m.add_command(label="添加子任务…", command=lambda: self.ask_add_sub(t))
        if subs_of(t):
            s2 = tk.Menu(m, tearoff=0, font=F_SMALL)
            s2.add_command(label="全部标记完成", command=lambda: self.set_all_subs(t, True))
            s2.add_command(label="全部取消完成", command=lambda: self.set_all_subs(t, False))
            s2.add_separator()
            s2.add_command(label="清空子任务", command=lambda: self.clear_subs(t))
            m.add_cascade(label="子任务 %d/%d" % (sub_done_n(t), len(subs_of(t))), menu=s2)

        m.add_separator()
        m.add_command(label=("暂停计时 · %s" % fmt_dur(spent_of(t))) if t.get("timer")
                            else "开始计时",
                      command=lambda: self.toggle_timer(t))
        if spent_of(t) > 0:
            m.add_command(label="清零耗时记录", command=lambda: self.reset_timer(t))

        m.add_separator()
        m.add_command(label="标记完成 / 取消", command=lambda: self.toggle_done(t))
        m.add_command(label="删除（进回收站）", command=lambda: self.delete_task(t))
        return m

    def show_canvas_menu(self, e):
        """右键点在空白处。"""
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        m.add_command(label="新建任务（跳到输入框）", command=self.entry.focus_set)
        m.add_command(label="耗时统计…", command=self.open_stats)
        m.add_command(label="每日复盘…", command=self.open_review)
        m.add_command(label="回收站…", command=self.open_trash)
        m.add_separator()
        m.add_command(label="清空已完成", command=self.do_clear_done)
        self._popup(m, x=e.x_root, y=e.y_root)

    # ============================================================ 操作

    def do_add(self):
        title = self.entry.get().strip()
        if not title:
            return
        self.tasks.append({
            "id": new_id(), "title": title, "note": "", "p": self.quick_p,
            "due": "", "done": False, "order": now_ts(),
            "subs": [], "logs": {}, "timer": 0,
            "repeat": "", "done_at": 0, "created_at": now_ts(), "remind_key": "",
        })
        self.entry.delete(0, "end")
        self.save()
        self.redraw()

    def toggle_done(self, t):
        t["done"] = not t["done"]
        nxt = None
        if t["done"]:
            t["done_at"] = now_ts()
            t["order"] = now_ts()
            if t.get("timer"):          # 勾上完成就顺手停表，免得一直空转
                self._stop_timer_data(t)
            nxt = self._spawn_next(t)   # 重复任务：顺手把下一次排上
        else:
            t["done_at"] = 0
        self.save()
        self.redraw()
        if nxt:
            self.status.configure(
                text="已完成「%s」，下一次已排到 %s"
                     % (ellipsis(t["title"], 10),
                        due_label(nxt["due"]) or "（未设日期）"))

    def set_repeat(self, t, r):
        t["repeat"] = r if r in REPEAT_LABEL else ""
        self.save()
        self.redraw()
        self.status.configure(text="重复：%s"
                                   % REPEAT_LABEL.get(t["repeat"], "不重复"))

    def _spawn_next(self, t):
        """重复任务被勾完成时，复制一份「下一次」出来。

        子任务结构照抄但全部重置为未完成；截止日期往后推一个周期。
        原任务留在原地，当"这一轮已经做完"的历史记录。"""
        rp = t.get("repeat") or ""
        if not rp:
            return None
        nxt = {
            "id": new_id(), "title": t["title"], "note": t["note"], "p": t["p"],
            "due": next_date(t["due"], rp), "done": False,
            "order": self._order_end(t["p"]),
            "subs": [{"id": new_sid(), "text": s["text"], "done": False,
                      "done_at": 0.0}
                     for s in subs_of(t)],
            "logs": {}, "timer": 0, "repeat": rp, "done_at": 0,
            # 新一轮从**现在**算起，而不是继承上一轮的创建时间 ——
            # 否则"这轮花了几天"会把重复任务的整个历史都算进去。
            "created_at": now_ts(), "remind_key": "",
        }
        self.tasks.append(nxt)
        return nxt

    def _order_end(self, p):
        """某个象限里「排到最后」用的 order。"""
        xs = [x["order"] for x in self.tasks if x["p"] == p]
        return (max(xs) + 1.0) if xs else 1.0

    def set_prio(self, t, p):
        t["p"] = p
        t["order"] = now_ts()
        self.save()
        self.redraw()

    def set_due(self, t, s):
        """设置截止日期/时间。传 "" 清除。

        存的形状只有两种（走 norm_due，别在这里自己拼）：
          "2026-10-15"              —— 只有日期，整天都算没到点
          "2026-10-15 18:30:05"     —— 带时刻，过了这个点就算逾期
        """
        if s:
            val = norm_due(s)
            if not val:
                return                      # 非法格式直接忽略，保持原值
            t["due"] = val
        else:
            t["due"] = ""
        self.save()
        self.redraw()

    def delete_task(self, t, quiet=False):
        """删除 = 移进回收站。所以删错了随时能捞回来（Ctrl+Z 或打开回收站）。"""
        try:
            self.tasks.remove(t)
        except ValueError:
            return
        self._to_trash(t)
        self.save()
        self.redraw()
        if not quiet:
            self._flash_undo("已把「%s」移入回收站" % ellipsis(t["title"], 12),
                             self.undo_delete)

    def _to_trash(self, t):
        """把任务整条搬进回收站，附上删除时间。超出上限就丢最旧的。"""
        self.trash.append({"deleted_at": now_ts(), "task": t})
        if len(self.trash) > TRASH_MAX:
            self.trash = self.trash[-TRASH_MAX:]

    def undo_delete(self):
        """把回收站里最新的一条捞回来。"""
        if not self.trash:
            self.status.configure(text="没有可撤销的删除")
            return None
        t = self.trash.pop()["task"]
        self.tasks.append(t)
        self.save()
        self.redraw()
        self.status.configure(text="已恢复「%s」" % ellipsis(t["title"], 12))
        return t

    def undo_batch(self, n):
        """一次捞回 n 条（撤销「清空已完成」用）。"""
        got = 0
        for _ in range(int(n)):
            if not self.trash:
                break
            self.tasks.append(self.trash.pop()["task"])
            got += 1
        if got:
            self.save()
            self.redraw()
            self.status.configure(text="已恢复 %d 条" % got)
        return got

    def do_clear_done(self):
        gone = [x for x in self.tasks if x["done"]]
        if not gone:
            self.status.configure(text="没有已完成的条目")
            return
        for t in gone:
            self.tasks.remove(t)
            self._to_trash(t)
        self.save()
        self.redraw()
        self._flash_undo("已把 %d 条已完成任务移入回收站" % len(gone),
                         lambda n=len(gone): self.undo_batch(n))

    # -------- 状态栏那个会自己消失的「撤销」按钮 --------

    def _flash_undo(self, text, cb, ms=6000):
        """在状态栏显示一条提示 + 一个「撤销」按钮，过一会儿自动收起。"""
        self._undo_cb = cb
        self.status.configure(text=text)
        self.undo_btn.grid()
        if self._undo_job:
            try:
                self.root.after_cancel(self._undo_job)
            except Exception:
                pass
        self._undo_job = self.root.after(ms, self._clear_undo)

    def _clear_undo(self):
        self._undo_job = None
        self._undo_cb = None
        try:
            self.undo_btn.grid_remove()
        except Exception:
            pass

    def _do_undo(self):
        cb = self._undo_cb
        self._clear_undo()
        if cb:
            cb()

    # -------- 计时 --------

    def _stop_timer_data(self, t):
        """把正在计时的那一段记账进 logs，并把 timer 归零。
        只动数据，不存盘也不重绘 —— 方便被别的操作（比如勾完成）顺手调用。"""
        st = t.get("timer") or 0
        if not st:
            return 0.0
        el = max(0.0, now_ts() - st)
        t["timer"] = 0
        if el >= 1:
            key = ts_day(st)        # 记在「开始那天」，跨午夜也不会算错日子
            logs = t.setdefault("logs", {})
            logs[key] = logs.get(key, 0.0) + el
        return el

    def toggle_timer(self, t):
        if t.get("timer"):
            el = self._stop_timer_data(t)
            self.save()
            self.redraw()
            self.status.configure(text="已暂停：本次 %s · 累计 %s"
                                       % (fmt_dur(el), fmt_dur(spent_of(t))))
        else:
            t["timer"] = now_ts()
            self.save()
            self.redraw()
            self.status.configure(text="开始计时：%s" % t["title"])

    def reset_timer(self, t):
        t["timer"] = 0
        t["logs"] = {}
        self.save()
        self.redraw()
        self.status.configure(text="已清零该任务的耗时记录")

    def commit_timers(self):
        """退出前把所有还在跑的计时落账，免得白计。"""
        n = 0
        for t in self.tasks:
            if t.get("timer"):
                self._stop_timer_data(t)
                n += 1
        return n

    def _tick(self):
        """心跳：有任务在计时时，每 HEARTBEAT_MS 刷一次界面让时长往上走。
        编辑中和拖拽中必须跳过 —— redraw 会清空画布，把输入框和
        被托起来的卡片一起抹掉。"""
        try:
            live = [t for t in self.tasks if t.get("timer")]
            if live and not self.drag and not self.editor:
                self.redraw()
            w = self._stats_win
            if live and w is not None and w.winfo_exists():
                self._render_stats()
            # 顺便看看有没有到点的任务。这一步极轻（只比日期），
            # 但也没必要每 15 秒做一次，按 REMIND_MS 节流。
            if now_ts() - self._last_remind_check >= REMIND_MS / 1000.0:
                self._last_remind_check = now_ts()
                self._maybe_remind()
        except Exception:
            pass
        self.root.after(HEARTBEAT_MS, self._tick)

    # -------- 子任务 --------

    def toggle_sub(self, t, sid):
        s = sub_by_id(t, sid)
        if not s:
            return
        s["done"] = not s["done"]
        # 完成时间（取消完成就清掉）：卡片上"已完成次日收起"靠它判断。
        # 跟主任务的 done_at 一个意思，只是子任务结构本身就轻，没别的兜底。
        s["done_at"] = now_ts() if s["done"] else 0.0
        self.save()
        self.redraw()
        self.status.configure(text="子任务 %d/%d 已完成"
                                   % (sub_done_n(t), len(subs_of(t))))

    def toggle_sub_done_view(self, t):
        """把这张卡上"收起的已完成子任务"临时摊开 / 再收回去。

        入口是「子任务 x/y」右边那个「已完成 N」胶囊。**状态只存在内存里**
        （SUB_SHOW_DONE，跟翻页页码一样不落库）：重开程序回到收起状态，
        因为"只看见还没做的"才是常态下想要的样子。
        """
        if t["id"] in SUB_SHOW_DONE:
            SUB_SHOW_DONE.discard(t["id"])
            self.status.configure(text="已收起的子任务又收起来了")
        else:
            SUB_SHOW_DONE.add(t["id"])
            self.status.configure(
                text="摊开了 %d 条已完成的子任务（它们是次日自动收起的）"
                     % hidden_sub_n(t))
        self.redraw()

    def add_subs(self, t, lines):
        """lines 可以是多行文本，一行算一条子任务。"""
        subs = t.setdefault("subs", [])
        added = 0
        for ln in lines:
            txt = str(ln).strip()
            if txt:
                subs.append({"id": new_sid(), "text": txt, "done": False,
                             "done_at": 0.0})
                added += 1
        if added:
            self.save()
            self.redraw()
            self.status.configure(text="已添加 %d 条子任务" % added)
        return added

    def del_sub(self, t, sid):
        subs = t.setdefault("subs", [])
        for i, s in enumerate(subs):
            if s["id"] == sid:
                subs.pop(i)
                break
        self.save()
        self.redraw()

    def nest_task(self, t, target, ask=True):
        """把任务 t 变成 target 的子任务（把卡片拖到别人卡片上半张就会走这里）。

        子任务只有一层，所以 t 自己带的子任务会被**摊平成同级**、备注和计时记录
        会丢 —— 这些信息一旦有，就先弹个确认框问一句，别默默吃掉。
        """
        if not t or not target or t is target:
            return False
        subs = subs_of(t)
        lost = []
        if subs:
            lost.append("%d 条子任务会摊平成同级" % len(subs))
        if t.get("note"):
            lost.append("备注会丢掉")
        if spent_of(t) > 0 or t.get("timer"):
            lost.append("计时记录会丢掉")
        if t.get("repeat"):
            lost.append("重复设置会丢掉")
        if lost and ask:
            if not tkmb.askyesno(
                    "变成子任务",
                    "把「%s」变成「%s」的子任务？\n\n%s。"
                    % (ellipsis(t["title"], 12), ellipsis(target["title"], 12),
                       "、".join(lost)),
                    parent=self.root):
                return False
        snap = self._snapshot()
        self._stop_timer_data(t)               # 先把计时收掉，别留个孤儿 timer
        dst = target.setdefault("subs", [])
        dst.append({"id": new_sid(), "text": t["title"], "done": bool(t["done"])})
        for s in subs:
            dst.append({"id": new_sid(), "text": s["text"],
                        "done": bool(s.get("done"))})
        try:
            self.tasks.remove(t)
        except ValueError:
            return False
        self.save()
        self.redraw()
        more = ("（卡面只显示前 %d 条，其余看计数）" % SUB_MAX) if len(dst) > SUB_MAX else ""
        self._flash_undo("已把「%s」变成「%s」的子任务%s"
                         % (ellipsis(t["title"], 10), ellipsis(target["title"], 10), more),
                         lambda: self._restore_snapshot(snap))
        return True

    def promote_sub(self, t, sid):
        """把子任务提升成独立任务，落在父任务那个象限、紧跟父任务后面。

        嵌套是单向门的话就太坑了（进得去出不来），所以必须有这一条。
        """
        subs = subs_of(t)
        s = sub_by_id(t, sid)
        if not s:
            return None
        snap = self._snapshot()
        done = bool(s.get("done"))
        nt = {"id": new_id(), "title": s["text"], "note": "", "p": t["p"],
              "due": "", "done": done, "order": t["order"] + 0.5,
              "subs": [], "logs": {}, "timer": 0, "repeat": "",
              "done_at": now_ts() if done else 0, "remind_key": ""}
        subs.remove(s)
        self.tasks.append(nt)
        # 重新编号这一组：+0.5 这种插法越用越密，顺手平一次
        for i, x in enumerate(sorted([x for x in self.tasks if x["p"] == t["p"]],
                                     key=self.sort_key)):
            x["order"] = float(i)
        self.save()
        self.redraw()
        self._flash_undo("已把「%s」提升成独立任务" % ellipsis(nt["title"], 10),
                         lambda: self._restore_snapshot(snap))
        return nt

    def move_sub(self, t, sid, delta):
        """子任务上移 / 下移一格（右键菜单用的，比拖拽稳）。"""
        subs = subs_of(t)
        i = next((k for k, s in enumerate(subs) if s["id"] == sid), None)
        if i is None:
            return
        j = i + delta
        if not (0 <= j < len(subs)):
            return
        snap = self._snapshot()
        subs[i], subs[j] = subs[j], subs[i]
        self.save()
        self.redraw()
        self._flash_undo("子任务顺序已调整", lambda: self._restore_snapshot(snap))

    def _snapshot(self):
        """改动前的整份任务列表。嵌套 / 提升 / 重排这类结构性改动整体还原最稳
        —— 逐条记「删了什么、加了什么」太容易漏。任务本来就是纯 JSON，
        round-trip 一下就得到互不干扰的深拷贝。"""
        return json.loads(json.dumps(self.tasks))

    def _restore_snapshot(self, snap):
        self.tasks = json.loads(json.dumps(snap))
        self.save()
        self.redraw()
        self.status.configure(text="已撤销")

    def set_all_subs(self, t, val):
        for s in subs_of(t):
            s["done"] = bool(val)
        self.save()
        self.redraw()

    def clear_subs(self, t):
        t["subs"] = []
        self.save()
        self.redraw()

    def ask_add_sub(self, t):
        """多行输入，方便一次把几件事粘进来。"""
        dlg = tk.Toplevel(self.root)
        dlg.title("添加子任务")
        dlg.configure(bg=C_BG)
        dlg.resizable(False, False)
        self._follow_top(dlg)
        dlg.grab_set()

        tk.Label(dlg, text="一行一条；也可以从别处复制多行直接粘进来",
                 font=F_SMALL, bg=C_BG, fg=C_INK2).pack(anchor="w", padx=18, pady=(16, 5))
        txt = tk.Text(dlg, font=F_BODY, width=36, height=6, bg=C_WHITE, fg=C_INK,
                      relief="flat", highlightthickness=1, highlightbackground=C_LINE,
                      highlightcolor="#c0ae8e", insertbackground=C_INK, wrap="word")
        txt.pack(padx=18)
        txt.focus_set()

        def ok(_e=None):
            lines = txt.get("1.0", "end").splitlines()
            dlg.destroy()
            self.add_subs(t, lines)

        tk.Label(dlg, text="Ctrl+回车 提交", font=F_SMALL, bg=C_BG, fg=C_INK3)\
            .pack(anchor="w", padx=18, pady=(5, 0))
        bar = tk.Frame(dlg, bg=C_BG)
        bar.pack(fill="x", padx=18, pady=(8, 16))
        self._btn(bar, "添加", ok, primary=True).pack(side="right")
        self._btn(bar, "取消", dlg.destroy).pack(side="right", padx=(0, 8))
        txt.bind("<Control-Return>", ok)

        dlg.update_idletasks()
        px = self.root.winfo_x() + (self.root.winfo_width() - dlg.winfo_width()) // 2
        py = self.root.winfo_y() + 140
        dlg.geometry("+%d+%d" % (max(0, px), max(0, py)))

    def popup_prio(self, t, e):
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        for pr in PRIOS:
            m.add_command(label=quad_full(pr["p"]),
                          command=lambda i=pr["p"]: self.set_prio(t, i))
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()

    def popup_repeat(self, t, e):
        """点卡片上那个重复小徽章时弹出来。"""
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        for k, label, _badge in REPEATS:
            m.add_command(label=("● " if (t.get("repeat") or "") == k else "    ") + label,
                          command=lambda kk=k: self.set_repeat(t, kk))
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()

    def due_from_input(self, day, clock):
        """把「日期 + 时间」两格的内容解析成存盘值。返回 (value, error)。

        · 两格都空 → ("", "")：清除截止时间
        · 只填时间 → 默认按今天算（不逼用户再补一遍日期）
        · error 非空 = 格式不对，value 为 ""（对话框拿它显示红字）

        抽成独立方法是为了能直接测：对话框一开就 grab_set，测试里不好碰。
        """
        day = str(day or "").strip().replace("/", "-").replace(".", "-")
        day = day.replace("年", "-").replace("月", "-").replace("日", "")
        clock = str(clock or "").strip().replace("：", ":").replace("。", ":")
        clock = clock.replace("点", ":").replace("时", ":")
        if not day and not clock:
            return "", ""
        if not day:
            day = d2s(today())
        if not s2d(day):
            return "", "日期格式不对，应为 2026-10-15"
        if clock:
            if not parse_dt("%s %s" % (day, clock)):
                return "", "时间格式不对，应为 18:30 或 18:30:05"
            return norm_due("%s %s" % (day, clock)), ""
        return norm_due(day), ""

    def build_due_date_menu(self, fill):
        """日期框右边「▾」的菜单内容（拆出来才能被测，同 build_filter_menu 的惯例）。"""
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        T = today()
        items = [("今天", 0), ("明天", 1), ("后天", 2),
                 ("本周末", (5 - T.weekday()) % 7 or 7),
                 ("下周一", (7 - T.weekday()) % 7 or 7)]
        for label, days in items:
            target = d2s(T + datetime.timedelta(days=days))
            m.add_command(label="%s　%s" % (label, target[5:]),
                          command=lambda v=target: fill(v))
        m.add_command(label="一个月后　%s" % d2s(add_months(T, 1))[5:],
                      command=lambda v=d2s(add_months(T, 1)): fill(v))
        m.add_separator()
        m.add_command(label="清空日期", command=lambda: fill(""))
        return m

    def build_due_time_menu(self, fill):
        """时间框右边「▾」的菜单内容：常用时刻 + 上下午整点。

        到"分"就够用了；要精确到秒就手写（22:15:30 这种没人想在下拉里翻）。
        """
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        for v in ("09:00", "12:00", "14:00", "18:00", "20:00", "22:00"):
            m.add_command(label=v, command=lambda x=v: fill(x))
        m.add_separator()
        am = tk.Menu(m, tearoff=0, font=F_SMALL)
        pm = tk.Menu(m, tearoff=0, font=F_SMALL)
        for h in range(12):
            am.add_command(label="%02d:00" % h, command=lambda x="%02d:00" % h: fill(x))
        for h in range(12, 24):
            pm.add_command(label="%02d:00" % h, command=lambda x="%02d:00" % h: fill(x))
        m.add_cascade(label="上午整点", menu=am)
        m.add_cascade(label="下午 / 晚上整点", menu=pm)
        m.add_separator()
        m.add_command(label="现在（到秒）",
                      command=lambda: fill(datetime.datetime.now().strftime("%H:%M:%S")))
        m.add_command(label="清空时间（改成整天）", command=lambda: fill(""))
        return m

    def ask_due(self, t):
        """设置截止日期 / 时间：**直接打字、或者点着选**，两条路都留着。

        用户的原话：「时间应该既可以手动填写，也可以筛选的形式，用浅色在输入框
        提示默认格式，这样输入的时候就可以手写或者选择时间。」

        所以这个框里有四样东西，改的都是同一份状态（就是那两个输入框）：
          ① 两个输入框，空着时显示**浅色格式提示**（2026-10-15 / 18:30:05）
          ② 每个框右边一个「▾」：日期给常用日期，时间给常用时刻 + 整点
          ③ 日期框下面一张**常驻小日历**，点哪天就填哪天（不用拉下拉再翻）
          ④ 底下实时预览「→ 2026-10-15 18:30:00（周四）」，写错当场红字提示

        小日历常驻而不是弹窗：弹窗要抢 grab，跟对话框自己的模态叠在一起容易出怪事
        （本项目已经踩过"模态一开主窗冻住"的坑），常驻只是多占一点高度。
        """
        cur = parse_dt(t.get("due", ""))
        cur_day = cur.strftime("%Y-%m-%d") if cur else ""
        cur_clock = cur.strftime("%H:%M:%S") \
            if (cur and due_has_time(t.get("due"))) else ""

        dlg = tk.Toplevel(self.root)
        dlg.title("设置截止时间")
        dlg.configure(bg=C_BG)
        dlg.resizable(False, False)
        self._follow_top(dlg)
        dlg.grab_set()

        fields = tk.Frame(dlg, bg=C_BG)
        fields.pack(fill="x", padx=18, pady=(16, 0))

        tk.Label(fields, text="日期", font=F_SMALL, bg=C_BG, fg=C_INK2)\
            .grid(row=0, column=0, padx=(0, 6))
        dent = _hint_entry(fields, "2026-10-15", width=12)
        dent.grid(row=0, column=1, ipady=5)
        ddn = tk.Button(fields, text="▾", font=F_SMALL, bd=0, relief="flat", padx=6,
                        bg=C_WHITE, fg=C_INK3, activebackground="#f0e9dc",
                        activeforeground=C_INK, cursor="hand2", highlightthickness=1,
                        highlightbackground=C_LINE)
        ddn.grid(row=0, column=2, padx=(3, 16), ipady=1)

        tk.Label(fields, text="时间", font=F_SMALL, bg=C_BG, fg=C_INK2)\
            .grid(row=0, column=3, padx=(0, 6))
        tent = _hint_entry(fields, "18:30:05", width=9)
        tent.grid(row=0, column=4, ipady=5)
        tdn = tk.Button(fields, text="▾", font=F_SMALL, bd=0, relief="flat", padx=6,
                        bg=C_WHITE, fg=C_INK3, activebackground="#f0e9dc",
                        activeforeground=C_INK, cursor="hand2", highlightthickness=1,
                        highlightbackground=C_LINE)
        tdn.grid(row=0, column=5, padx=(3, 0), ipady=1)

        if cur_day:
            hint_set(dent, cur_day)
        if cur_clock:
            hint_set(tent, cur_clock)

        tk.Label(dlg, text="时间留空 = 那一整天都算没到点；秒可以不写。",
                 font=F_SMALL, bg=C_BG, fg=C_INK3).pack(anchor="w", padx=18,
                                                        pady=(6, 0))

        # ---- 常驻小日历 ----
        cal = tk.Frame(dlg, bg=C_WHITE, highlightthickness=1,
                       highlightbackground=C_LINE)
        cal.pack(fill="x", padx=18, pady=(8, 0))
        chead = tk.Frame(cal, bg=C_WHITE)
        chead.pack(fill="x", padx=6, pady=(6, 0))
        base = cur.date() if cur else today()
        st = {"y": base.year, "m": base.month}
        tk.Button(chead, text="上月", font=F_SMALL, bd=0, relief="flat", padx=5,
                  bg=C_WHITE, fg=C_INK3, activebackground="#f0e9dc",
                  activeforeground=C_INK, cursor="hand2", highlightthickness=0,
                  command=lambda: shift_month(-1)).pack(side="left")
        ctitle = tk.Label(chead, text="", font=F_SMALL, bg=C_WHITE, fg=C_INK)
        ctitle.pack(side="left", expand=True)
        tk.Button(chead, text="下月", font=F_SMALL, bd=0, relief="flat", padx=5,
                  bg=C_WHITE, fg=C_INK3, activebackground="#f0e9dc",
                  activeforeground=C_INK, cursor="hand2", highlightthickness=0,
                  command=lambda: shift_month(+1)).pack(side="right")
        cgrid = tk.Frame(cal, bg=C_WHITE)
        cgrid.pack(padx=6, pady=(2, 6))

        def shift_month(delta):
            nm = add_months(datetime.date(st["y"], st["m"], 1), delta)
            st["y"], st["m"] = nm.year, nm.month
            draw_cal()

        def draw_cal():
            """重画这一页日历（换月、选中变化都走它 —— 只有这一处建格子）。"""
            for w in cgrid.winfo_children():
                w.destroy()
            ctitle.configure(text="%d 年 %d 月" % (st["y"], st["m"]))
            for i, wd in enumerate("一二三四五六日"):
                tk.Label(cgrid, text=wd, font=F_TINY, bg=C_WHITE, fg=C_INK3,
                         width=3).grid(row=0, column=i, pady=(0, 2))
            sel_txt = hint_value(dent)
            sel = s2d(sel_txt) if sel_txt else None
            T = today()
            for ri, week in enumerate(month_grid(st["y"], st["m"]), start=1):
                for ci, d in enumerate(week):
                    if d is None:
                        tk.Label(cgrid, text="", width=3, bg=C_WHITE)\
                            .grid(row=ri, column=ci, padx=1, pady=1)
                        continue
                    is_sel = (sel == d)
                    bg = C_INK if is_sel else ("#f2ece0" if d == T else C_WHITE)
                    fg = "#ffffff" if is_sel else (C_INK if d >= T else C_INK3)
                    lb = tk.Label(cgrid, text=str(d.day), font=F_SMALL, bg=bg, fg=fg,
                                  width=3, pady=2, cursor="hand2")
                    lb.grid(row=ri, column=ci, padx=1, pady=1)
                    lb.bind("<Button-1>", lambda e, dd=d: pick_day(dd))
            st["drawn"] = sel_txt

        pv = tk.Label(dlg, text="", font=F_SMALL, bg=C_BG, fg=C_INK2)
        pv.pack(anchor="w", padx=18, pady=(8, 0))
        err_lb = tk.Label(dlg, text="", font=F_SMALL, bg=C_BG, fg="#c4262e")
        err_lb.pack(anchor="w", padx=18)

        def refresh(*_a):
            """两格内容 → 「会存成什么」的实时预览 + 格式检查。"""
            val, err = self.due_from_input(hint_value(dent), hint_value(tent))
            if err:
                err_lb.configure(text=err)
                pv.configure(text="")
                return
            err_lb.configure(text="")
            if not val:
                pv.configure(text="不设截止时间（卡片底部只剩「＋ 日期」）")
                return
            dt = parse_dt(val)
            wd = "周" + "一二三四五六日"[dt.weekday()]
            tail = "" if due_has_time(val) else " 全天"
            pv.configure(text="→ %s%s（%s）" % (due_label(val), tail, wd))
            # 手写日期也要让日历跟着高亮 —— 但只在"选中那天真的变了"时重画，
            # 不然每敲一个键都重建四十个格子会闪。
            if hint_value(dent) != st.get("drawn"):
                draw_cal()

        def pick_day(d):
            hint_set(dent, d2s(d))
            refresh()
            draw_cal()

        def fill_d(v):
            hint_set(dent, v)
            refresh()
            draw_cal()

        def fill_t(v):
            hint_set(tent, v)
            refresh()

        def quick(days):
            hint_set(dent, d2s(today() + datetime.timedelta(days=days)))
            refresh()
            draw_cal()

        def quick_now():
            hint_set(dent, d2s(today()))
            hint_set(tent, datetime.datetime.now().strftime("%H:%M:%S"))
            refresh()
            draw_cal()

        def clear_both():
            hint_set(dent, "")
            hint_set(tent, "")
            refresh()
            draw_cal()

        def apply():
            val, err = self.due_from_input(hint_value(dent), hint_value(tent))
            if err:
                err_lb.configure(text=err)      # 不关窗，让人就地改
                return
            self.set_due(t, val)
            dlg.destroy()

        for e in (dent, tent):
            e.bind("<KeyRelease>", refresh)
            e.bind("<Return>", lambda _e: apply())

        # 两个「▾」的菜单也要 refresh/draw_cal，所以等这几个闭包都定义好再挂
        ddn.configure(command=lambda: self._popup(self.build_due_date_menu(fill_d),
                                                  ddn))
        tdn.configure(command=lambda: self._popup(self.build_due_time_menu(fill_t),
                                                  tdn))

        bar = tk.Frame(dlg, bg=C_BG)
        bar.pack(fill="x", padx=18, pady=(8, 4))
        self._btn(bar, "今天", lambda: quick(0)).pack(side="left", padx=(0, 6))
        self._btn(bar, "明天", lambda: quick(1)).pack(side="left", padx=(0, 6))
        self._btn(bar, "本周末", lambda: quick((5 - today().weekday()) % 7 or 7))\
            .pack(side="left", padx=(0, 6))
        self._btn(bar, "现在", quick_now).pack(side="left", padx=(0, 6))
        self._btn(bar, "清除", clear_both).pack(side="left")

        bar2 = tk.Frame(dlg, bg=C_BG)
        bar2.pack(fill="x", padx=18, pady=(4, 16))
        self._btn(bar2, "确定", apply, primary=True).pack(side="right")
        self._btn(bar2, "取消", dlg.destroy).pack(side="right", padx=(0, 8))

        dlg.bind("<Escape>", lambda e: dlg.destroy())
        dlg.bind("<Return>", lambda e: apply())
        # 供自测/截图直接触发（真实用户走的是 KeyRelease → refresh）
        dlg._due_refresh = refresh
        dlg._due_apply = apply
        dlg._due_entries = (dent, tent)
        draw_cal()
        refresh()
        # **焦点给对话框本身，不给日期框**：给输入框的话 FocusIn 会立刻把浅色
        # 格式提示清掉，"该写成什么样"的例子就再也看不到了（这正是用户提的问题）。
        # 点进哪一格，那一格的提示才让位。
        dlg.focus_set()
        dlg.update_idletasks()
        px = self.root.winfo_x() + (self.root.winfo_width() - dlg.winfo_width()) // 2
        py = self.root.winfo_y() + 90
        dlg.geometry("+%d+%d" % (max(0, px), max(0, py)))

    def set_title(self, t, txt):
        """改标题。空标题会被忽略 —— 卡片没了标题就没法认了。
        就地编辑（双击）和「编辑任务」对话框都走这里，标题只有一个落库出口。"""
        txt = (txt or "").strip()
        if not txt or txt == t["title"]:
            return
        t["title"] = txt
        self.save()
        self.redraw()

    # ---------------------------------------------------- 象限（可增删、可改名）

    def build_quad_menu(self, p):
        """象限标题右键菜单。拆成独立方法是为了能被测试直接调用（同 build_more_menu）。"""
        pr = PRIO_BY_P[p]
        m = tk.Menu(self.root, tearoff=0, font=F_SMALL)
        m.add_command(label="改这个名字…", command=lambda: self.ask_quads(p))
        m.add_command(label="在它后面新增一格",
                      state=("normal" if len(PRIOS) < MAX_QUADS else "disabled"),
                      command=lambda: self.add_quad(after=p))
        m.add_command(label="删除这一格…",
                      state=("normal" if len(PRIOS) > 1 else "disabled"),
                      command=lambda: self.delete_quad(p))
        m.add_separator()
        has_default = p < len(QUAD_DEFAULTS)
        m.add_command(label="这一格恢复默认名字",
                      state=("normal" if has_default
                             and (pr["name"], pr["act"]) != QUAD_DEFAULTS[p] else "disabled"),
                      command=lambda: self.reset_quads(p))
        m.add_command(label="全部恢复出厂四个…", command=lambda: self.reset_quads())
        return m

    def apply_quads(self, items, mapping=None):
        """整套换掉象限（数量 / 名字 / 颜色一起），并把任务搬到新的格子里。

        `mapping` 是「旧 p → 新 p」。删格子时任务必须跟着搬 —— 用户想删的是
        **一个分类**，不是里面的任务。不给 mapping 就按位置对应（改名/新增）。

        这里也是唯一"落库 + 重绘 + 重建顶栏按钮"的出口，别在别处零散改 PRIOS。
        """
        old_n = len(PRIOS)
        apply_quad_labels(items)
        new_n = len(PRIOS)
        if mapping is None:
            mapping = {i: (i if i < new_n else new_n - 1) for i in range(old_n)}

        def land(p):
            try:
                p = int(p or 0)
            except (TypeError, ValueError):
                p = 0
            return max(0, min(int(mapping.get(p, min(p, new_n - 1))), new_n - 1))

        for t in self.tasks:
            t["p"] = land(t.get("p"))
        for k in self.trash:                     # 回收站里的也一起搬，捞回来才落得进去
            task = k.get("task") if isinstance(k, dict) else None
            if isinstance(task, dict):
                task["p"] = land(task.get("p"))
        self.quick_p = max(0, min(int(mapping.get(self.quick_p, self.quick_p)), new_n - 1))
        # 页码是按 p 存的：格子重排之后全部作废（不然会翻到不存在的页）
        self.quad_page.clear()
        self.ui["quads"] = quad_labels()
        self._rebuild_quick()
        self.save()
        self.redraw()

    def add_quad(self, after=None, name=None, act=""):
        """新增一格，插在 after 后面（None = 追加到末尾）。返回它的下标。"""
        if len(PRIOS) >= MAX_QUADS:
            self.status.configure(text="最多 %d 个象限（再多就记不住哪个是哪个了）" % MAX_QUADS)
            return None
        items = quad_labels()
        pos = len(items) if after is None else max(0, min(int(after) + 1, len(items)))
        new_name = name or "新象限"
        items.insert(pos, {"name": new_name, "act": act, "c": _free_color(items)})
        self.apply_quads(items)
        # 名字先存下来再用：apply_quads 之后 PRIO_BY_P 已经按新列表重建过，
        # 这时候再回查下标属于"绕远路"，边界上一错就是 KeyError
        self.status.configure(text="加了一格「%s」—— 点它的标题就能改名" % new_name)
        return pos

    def delete_quad(self, p, ask=True):
        """删掉一格。里面的任务挪到**相邻那格**（前一个，没有就后一个）。

        不能连任务一起删：用户说的是"删掉这个分类"，不是"删掉这些事"。
        """
        if len(PRIOS) <= 1:
            self.status.configure(text="至少要留一个象限")
            return False
        name = PRIO_BY_P[p]["name"]
        tgt_old = p - 1 if p > 0 else p + 1
        tgt_name = PRIO_BY_P[tgt_old]["name"]
        n = len([t for t in self.tasks if t["p"] == p])
        if ask:
            msg = ("「%s」里还有 %d 条任务。\n\n删掉这个格子后，它们会被搬到「%s」——"
                   "任务本身不会丢。\n\n继续？" % (name, n, tgt_name)) if n else \
                  ("删掉「%s」这个格子？\n\n里面没有任务。" % name)
            if not tkmb.askyesno("删除象限", msg):
                return False
        items = [x for i, x in enumerate(quad_labels()) if i != p]
        mapping = {}
        for i in range(len(PRIOS)):
            if i != p:
                mapping[i] = i if i < p else i - 1
        mapping[p] = mapping[tgt_old]
        self.apply_quads(items, mapping)
        self.status.configure(text="已删掉「%s」%s" % (
            name, ("，%d 条任务搬到了「%s」" % (n, tgt_name)) if n else ""))
        return True

    def set_quad_labels(self, labels, p=None):
        """保存整套象限（数量可变）。坐标/数量都不变时等价于"改名字"。"""
        self.apply_quads([dict(x) for x in labels])
        if p is None:
            self.status.configure(text="象限已更新（现在 %d 个）" % len(PRIOS))
        else:
            self.status.configure(text="这一格现在叫「%s」"
                                       % PRIO_BY_P[min(p, len(PRIOS) - 1)]["name"])

    def reset_quads(self, p=None):
        if p is not None:
            reset_quad_labels(p)
            self.ui["quads"] = quad_labels()
            self.save()
            self.redraw()
            self.status.configure(text="「%s」恢复成默认名字" % PRIO_BY_P[p]["key"])
            return True
        extra = max(0, len(PRIOS) - len(QUAD_DEFAULTS))
        if extra and not tkmb.askyesno(
                "恢复出厂象限",
                "会变回出厂那 4 个象限，多出来的 %d 个格子会被删掉。\n\n"
                "它们里面的任务会搬到前 4 格里（任务本身不会丢）。\n\n继续？" % extra):
            return False
        mapping = {i: min(i, len(QUAD_DEFAULTS) - 1) for i in range(len(PRIOS))}
        self.apply_quads(_default_quad_items(), mapping)
        self.status.configure(text="已恢复出厂那 4 个象限")
        return True

    def ask_quads(self, p=None):
        """象限设置：改名、改说明、加一格、删一格，一次改完。

        `p` = 从哪一格点进来的（光标先落在那儿），其余照样都能改。

        数量上限 MAX_QUADS：再多没人记得住哪个是哪个，顶栏那排小按钮也会挤爆。
        配色不开放改 —— 靠颜色区分格子，自己挑容易撞在一起；新增的格子由程序
        从配色板里挑一个还没人用的颜色。
        """
        dlg = tk.Toplevel(self.root)
        dlg.title("象限设置")
        dlg.configure(bg=C_BG)
        dlg.resizable(False, False)
        self._follow_top(dlg)
        dlg.grab_set()

        tk.Label(dlg, text="象限就是一种分类方式：工作 / 学习 / 娱乐 / 生活…… 想要几个就几个（最多 %d 个）"
                          % MAX_QUADS,
                 font=F_SMALL, bg=C_BG, fg=C_INK2).pack(anchor="w", padx=18, pady=(16, 2))
        tk.Label(dlg, text="名字必填，后面那句说明可以不填。颜色由程序分配，不开放修改。",
                 font=F_SMALL, bg=C_BG, fg=C_INK3).pack(anchor="w", padx=18)

        box = tk.Frame(dlg, bg=C_BG)
        box.pack(fill="x", padx=18, pady=(8, 0))
        rows = []
        # 先建行、后定义 save()，所以回车事件不能直接闭包引用 save（那时它还没
        # 绑定，会 NameError: free variable）。用一个字典在事件发生时才取。
        hooks = {}

        def make_row(name, act, c, orig):
            f = tk.Frame(box, bg=C_BG)
            f.pack(fill="x", pady=3)
            tk.Label(f, text="●", font=F_BODY, bg=C_BG, width=2,
                     fg=QUAD_PALETTE[int(c) % len(QUAD_PALETTE)][1]).pack(side="left")
            ne = tk.Entry(f, font=F_BODY, width=12, bg=C_WHITE, fg=C_INK, relief="flat",
                          highlightthickness=1, highlightbackground=C_LINE,
                          highlightcolor="#c0ae8e", insertbackground=C_INK)
            ne.insert(0, name)
            ne.pack(side="left", ipady=4, fill="x", expand=True)
            tk.Label(f, text="·", font=F_SMALL, bg=C_BG, fg=C_INK3).pack(side="left", padx=6)
            ae = tk.Entry(f, font=F_SMALL, width=14, bg=C_WHITE, fg=C_INK2, relief="flat",
                          highlightthickness=1, highlightbackground=C_LINE,
                          highlightcolor="#c0ae8e", insertbackground=C_INK)
            ae.insert(0, act)
            ae.pack(side="left", ipady=4)
            xb = tk.Button(f, text="×", font=F_SMALL, bd=0, relief="flat", padx=6, pady=2,
                           bg=C_BG, fg=C_INK3, activebackground="#f0e9dc",
                           activeforeground="#c4262e", cursor="hand2",
                           highlightthickness=0)
            xb.pack(side="left", padx=(4, 0))
            row = {"f": f, "name": ne, "act": ae, "c": c, "orig": orig}
            xb.configure(command=lambda rr=row: drop_row(rr))
            ne.bind("<Return>", lambda e: hooks["save"](e))
            ae.bind("<Return>", lambda e: hooks["save"](e))
            return row

        def drop_row(row):
            if len(rows) <= 1:
                err.configure(text="至少要留一个象限（任务总得落在某个格子里）")
                return
            row["f"].destroy()
            rows.remove(row)
            err.configure(text="")

        for i, pr in enumerate(PRIOS):
            rows.append(make_row(pr["name"], pr["act"], pr["c"], i))

        err = tk.Label(dlg, text="", font=F_SMALL, bg=C_BG, fg="#c4262e")
        err.pack(anchor="w", padx=18, pady=(2, 0))
        tk.Label(dlg, text="回车 = 保存 · Esc = 取消 · 删掉的格子里的任务会搬到相邻那格",
                 font=F_SMALL, bg=C_BG, fg=C_INK3).pack(anchor="w", padx=18)

        def add_row_click():
            if len(rows) >= MAX_QUADS:
                err.configure(text="最多 %d 个象限" % MAX_QUADS)
                return
            rows.append(make_row("新象限", "", _free_color(rows), None))
            err.configure(text="")
            dlg.update_idletasks()
            rows[-1]["name"].focus_set()

        def save(_e=None):
            data = []
            for i, row in enumerate(rows):
                nm = row["name"].get().strip()
                if not nm:                     # 名字不许空，留在框里让用户改
                    err.configure(text="第 %d 格的名字不能为空" % (i + 1))
                    row["name"].focus_set()
                    return
                data.append({"name": nm, "act": row["act"].get().strip(),
                             "c": row["c"], "orig": row["orig"]})
            # 旧 p -> 新 p：留下的按 orig 认人；被删的那些搬到最近的一个活着的格子
            mapping = {it["orig"]: i for i, it in enumerate(data) if it["orig"] is not None}
            alive = sorted(mapping)
            for old in range(len(PRIOS)):
                if old in mapping:
                    continue
                prev = [x for x in alive if x < old]
                nxt = [x for x in alive if x > old]
                src = prev[-1] if prev else (nxt[0] if nxt else (alive[0] if alive else 0))
                mapping[old] = mapping.get(src, 0)
            items = [{"name": it["name"], "act": it["act"], "c": it["c"]} for it in data]
            dlg.destroy()
            self.apply_quads(items, mapping)
            self.status.configure(text="象限已更新（现在 %d 个）" % len(items))

        hooks["save"] = save

        def fill_default():
            # 只把名字填回出厂值，**不改数量、不改顺序** —— 用户可能只想复原文字
            for i, row in enumerate(rows):
                n, a = (QUAD_DEFAULTS[i] if i < len(QUAD_DEFAULTS)
                        else ("象限%d" % (i + 1), ""))
                row["name"].delete(0, "end")
                row["name"].insert(0, n)
                row["act"].delete(0, "end")
                row["act"].insert(0, a)
            err.configure(text="")

        dlg.bind("<Escape>", lambda e: dlg.destroy())

        bar = tk.Frame(dlg, bg=C_BG)
        bar.pack(fill="x", padx=18, pady=(8, 16))
        self._btn(bar, "＋ 新增一格", add_row_click).pack(side="left")
        self._btn(bar, "名字填回默认", fill_default).pack(side="left", padx=(8, 0))
        self._btn(bar, "保存", save, primary=True).pack(side="right")
        self._btn(bar, "取消", dlg.destroy).pack(side="right", padx=(0, 8))

        dlg.minsize(430, 0)
        dlg.update_idletasks()
        px = self.root.winfo_x() + (self.root.winfo_width() - dlg.winfo_width()) // 2
        py = self.root.winfo_y() + 110
        dlg.geometry("+%d+%d" % (max(0, px), max(0, py)))
        (rows[p] if p is not None and 0 <= p < len(rows) else rows[0])["name"].focus_set()

    def ask_edit(self, t, focus="title"):
        """编辑一条任务：标题 + 备注 一起改。

        `focus` 决定光标先落在哪个框 —— 卡片上点那行「＋ 备注」时传 "note"，
        从右键菜单进来就落在标题上（错别字是第一诉求）。

        按键：回车 = 保存（两个框都是），Shift+回车 = 备注换行，Esc = 取消。

        这里【不】单独做「改优先级 / 截止日期」，那些卡片上有更快的入口
        （拖拽换象限、点药丸、右键各自的菜单），塞进这个框反而绕远。
        """
        dlg = tk.Toplevel(self.root)
        dlg.title("编辑任务")
        dlg.configure(bg=C_BG)
        dlg.resizable(False, False)
        self._follow_top(dlg)
        dlg.grab_set()

        tk.Label(dlg, text="标题", font=F_SMALL, bg=C_BG, fg=C_INK2)\
            .pack(anchor="w", padx=18, pady=(16, 3))
        ent = tk.Entry(dlg, font=F_BODY, width=40, bg=C_WHITE, fg=C_INK, relief="flat",
                       highlightthickness=1, highlightbackground=C_LINE,
                       highlightcolor="#c0ae8e", insertbackground=C_INK)
        ent.pack(padx=18, ipady=5, fill="x")
        ent.insert(0, t["title"])

        tk.Label(dlg, text="备注", font=F_SMALL, bg=C_BG, fg=C_INK2)\
            .pack(anchor="w", padx=18, pady=(10, 3))
        txt = tk.Text(dlg, font=F_BODY, width=40, height=4, bg=C_WHITE, fg=C_INK,
                      relief="flat", highlightthickness=1, highlightbackground=C_LINE,
                      highlightcolor="#c0ae8e", insertbackground=C_INK, wrap="word")
        txt.pack(padx=18)
        if t["note"]:
            txt.insert("1.0", t["note"])

        err = tk.Label(dlg, text="", font=F_SMALL, bg=C_BG, fg="#c4262e")
        err.pack(anchor="w", padx=18)
        tk.Label(dlg, text="回车 = 保存 · Shift+回车 = 换行 · 备注留空则删除",
                 font=F_SMALL, bg=C_BG, fg=C_INK3).pack(anchor="w", padx=18)

        def save(_e=None):
            title = ent.get().strip()
            if not title:                 # 标题不允许为空，留在框里让用户改
                err.configure(text="标题不能为空")
                ent.focus_set()
                return
            note = txt.get("1.0", "end").strip()
            dlg.destroy()
            self.set_title(t, title)
            self.set_note(t, note)
            self.status.configure(text="已保存「%s」的修改" % ellipsis(title, 12))

        def drop():
            dlg.destroy()
            self.del_note(t)

        bar = tk.Frame(dlg, bg=C_BG)
        bar.pack(fill="x", padx=18, pady=(8, 16))
        self._btn(bar, "保存", save, primary=True).pack(side="right")
        self._btn(bar, "取消", dlg.destroy).pack(side="right", padx=(0, 8))
        if t["note"]:
            self._btn(bar, "删除备注", drop).pack(side="left")
        def save_ret(_e=None):
            """备注框里按回车 = 保存。返回 "break" 挡掉 Text 自带的换行行为。"""
            save()
            return "break"

        def newline(_e=None):
            """Shift+回车 = 真换行。备注还是得多行才够用，不能只会保存。"""
            txt.insert("insert", "\n")
            return "break"

        ent.bind("<Return>", save)            # 标题框：回车保存
        txt.bind("<Return>", save_ret)        # 备注框：回车也保存（只有按钮太别扭）
        txt.bind("<Shift-Return>", newline)   # 备注框：Shift+回车换行
        dlg.bind("<Escape>", lambda e: dlg.destroy())   # Esc = 取消，不保存

        dlg.update_idletasks()
        px = self.root.winfo_x() + (self.root.winfo_width() - dlg.winfo_width()) // 2
        py = self.root.winfo_y() + 110
        dlg.geometry("+%d+%d" % (max(0, px), max(0, py)))
        if focus == "note":
            txt.focus_set()
            txt.mark_set("insert", "end-1c")
        else:
            ent.focus_set()
            ent.select_range(0, "end")

    def set_note(self, t, txt):
        """改备注（空字符串就是删掉）。保存 / 重画都走这里，和就地编辑同一个出口。

        换行统一成 \\n：aardio 的 edit 交出来的是 \\r\\n，而两版共用一份
        tasks.json —— 不统一的话对面的卡片上会多出一个看不见的 \\r。
        """
        old = t["note"]
        txt = (txt or "").replace("\r\n", "\n").replace("\r", "\n")
        if txt == old:
            return
        t["note"] = txt
        self.save()
        self.redraw()
        if txt:
            self.status.configure(text="已保存「%s」的备注" % ellipsis(t["title"], 10))
        else:
            self.status.configure(text="已删除「%s」的备注" % ellipsis(t["title"], 10))

    def del_note(self, t):
        """删备注，并留一个撤销入口 —— 备注是手写的内容，误删了要能马上捞回来。"""
        tid, old = t["id"], t["note"]
        if not old:
            return
        t["note"] = ""
        self.save()
        self.redraw()

        def undo():
            tt = self.task_by_id(tid)      # 任务对象可能已被替换，按 id 现取
            if tt:
                self.set_note(tt, old)
        self._flash_undo("已删除「%s」的备注" % ellipsis(t["title"], 10), undo)

    # ============================================================ 就地编辑

    def open_editor(self, t, field):
        if self.editor:
            self._commit_editor()

        # field 同时也是 regions 里的「类型」：
        #   "title" / "note"        → 任务自己的字段
        #   "st:<子任务id>"          → 某一条子任务的文字
        box, font, val = None, F_BODY, t["note"]
        for kind, tid, x1, y1, x2, y2 in reversed(self.regions):
            if kind == field and tid == t["id"]:
                box = (x1, y1, x2, y2)
                break
        if not box:
            return
        if field == "title":
            font, val = F_TITLE, t["title"]
        elif field.startswith("st:"):
            s = sub_by_id(t, field[3:])
            if not s:
                return
            font, val = F_SUB, s["text"]

        x1, y1, x2, y2 = box
        h = max(24, y2 - y1)
        ent = tk.Entry(self.cv, font=font, bg=C_WHITE, fg=C_INK, relief="flat",
                       highlightthickness=2, highlightbackground="#c0ae8e",
                       highlightcolor="#a9967a", insertbackground=C_INK)
        win = self.cv.create_window(x1 + 2, y1 + 1, window=ent, anchor="nw",
                                    width=max(40, x2 - x1 - 4), height=h, tags="editor")
        ent.insert(0, val)
        ent.focus_set()
        ent.select_range(0, "end")
        self.editor = {"t": t, "field": field, "entry": ent, "win": win}

        ent.bind("<Return>", lambda e: self._commit_editor())
        ent.bind("<Escape>", lambda e: self.cancel_editor())
        # 注意：这里故意【不】绑 FocusOut 来提交。
        # 实测发现：当窗口本身还没拿到系统焦点时（比如程序刚启动、或者被
        # 别的窗口压着），输入框一建好就会收到一次「假的」FocusOut，于是
        # 编辑器刚打开就被自动提交，闪一下就没了。改成「点到输入框以外的
        # 地方就提交」，见 _maybe_commit_editor —— 行为可预测，也测得住。
        #
        # 另外：进门的路有两条。菜单点进来的是直接调用，立刻建；
        # 双击卡片进来的由 on_double 用 after_idle 延后一轮 —— 那是为了躲开
        # 同一次「按下」里的那条提交检查，原因写在那个 after_idle 上面。

    def _maybe_commit_editor(self, e):
        """点到输入框以外的任何地方，就把就地编辑的内容提交掉。"""
        if not self.editor:
            return
        try:
            under = self.root.winfo_containing(e.x_root, e.y_root)
        except Exception:
            under = None
        if under is not None and under is self.editor["entry"]:
            return                      # 点在输入框自己身上，继续编辑
        self._commit_editor()

    def _commit_editor(self):
        """保存并关闭就地编辑器。返回 True 表示确实提交了内容。"""
        ed = self.editor
        if not ed:
            return False
        txt = ed["entry"].get().strip()
        t, field = ed["t"], ed["field"]
        self.editor = None
        self.cv.delete("editor")
        if field == "title":
            self.set_title(t, txt)        # 空标题会被忽略，保持原样
            return True                   # set_title 里已经 save + redraw 过了
        if field == "note":
            self.set_note(t, txt)         # 备注只走这一个落库出口（含换行归一化）
            return True
        if field.startswith("st:"):
            s = sub_by_id(t, field[3:])
            if s:
                if txt:
                    s["text"] = txt
                else:                     # 子任务文字清空 = 删掉这条
                    subs = t.setdefault("subs", [])
                    for i, x in enumerate(subs):
                        if x["id"] == s["id"]:
                            subs.pop(i)
                            break
        self.save()
        self.redraw()
        return True

    def cancel_editor(self):
        if self.editor:
            self.editor = None
            self.cv.delete("editor")
            self.cv.focus_set()

    # ============================================================ 回收站

    def trash_text(self, i):
        """把回收站第 i 条渲染成一行文字。"""
        it = self.trash[i]
        t = it["task"]
        ts = _norm_num(it.get("deleted_at"))
        when = datetime.datetime.fromtimestamp(ts).strftime("%m-%d %H:%M") if ts else "  --  "
        return "  %s   %s%s" % (when, ellipsis(t["title"], 20),
                                "   （已完成）" if t.get("done") else "")

    def open_trash(self):
        w = self._trash_win
        if w is not None and w.winfo_exists():
            w.lift()
            self._fill_trash()
            return
        w = tk.Toplevel(self.root)
        w.title("回收站")
        w.configure(bg=C_BG)
        self._follow_top(w)
        w.minsize(380, 320)
        w.geometry("430x420")
        self._trash_win = w

        tk.Label(w, text="删掉的任务先放进这里，随时能捞回来。",
                 font=F_SMALL, bg=C_BG, fg=C_INK3, anchor="w")\
            .pack(fill="x", padx=16, pady=(14, 6))

        wrap = tk.Frame(w, bg=C_BG)
        wrap.pack(fill="both", expand=True, padx=16)
        self._trash_list = tk.Listbox(
            wrap, font=F_BODY, bg=C_WHITE, fg=C_INK, relief="flat",
            highlightthickness=1, highlightbackground=C_LINE,
            selectbackground="#dcd3c2", selectforeground=C_INK,
            activestyle="none", bd=0)
        self._trash_list.pack(side="left", fill="both", expand=True)
        sb = tk.Scrollbar(wrap, orient="vertical", command=self._trash_list.yview,
                          width=12, troughcolor=C_BG, relief="flat", bd=0)
        sb.pack(side="right", fill="y")
        self._trash_list.configure(yscrollcommand=sb.set)
        self._trash_list.bind("<Double-Button-1>", lambda e: self.trash_restore())

        bar = tk.Frame(w, bg=C_BG)
        bar.pack(fill="x", padx=16, pady=(10, 14))
        self._btn(bar, "恢复选中", self.trash_restore).pack(side="left", padx=(0, 7))
        self._btn(bar, "彻底删除", self.trash_purge).pack(side="left", padx=(0, 7))
        self._btn(bar, "清空回收站", self.trash_empty).pack(side="left")
        self._btn(bar, "关闭", w.destroy).pack(side="right")

        self._fill_trash()
        w.update_idletasks()
        px = self.root.winfo_x() + self.root.winfo_width() - w.winfo_reqwidth() - 40
        py = self.root.winfo_y() + 130
        w.geometry("+%d+%d" % (max(0, px), max(0, py)))

    def _fill_trash(self):
        lb = getattr(self, "_trash_list", None)
        if lb is None or not lb.winfo_exists():
            return
        lb.delete(0, "end")
        if not self.trash:
            lb.insert("end", "   （回收站是空的）")
            return
        for i in range(len(self.trash)):
            lb.insert("end", self.trash_text(i))

    def _trash_sel(self):
        lb = getattr(self, "_trash_list", None)
        if lb is None or not lb.winfo_exists():
            return []
        return [i for i in lb.curselection() if 0 <= i < len(self.trash)]

    def trash_restore(self):
        sel = self._trash_sel()
        if not sel:
            self.status.configure(text="先在列表里点一条，再点「恢复选中」")
            return 0
        for i in sorted(sel, reverse=True):
            self.tasks.append(self.trash.pop(i)["task"])
        self.save()
        self.redraw()
        self._fill_trash()
        self.status.configure(text="已恢复 %d 条" % len(sel))
        return len(sel)

    def trash_purge(self):
        """彻底删除 —— 到这一步才真的不可挽回，所以要问一句。"""
        sel = self._trash_sel()
        if not sel:
            self.status.configure(text="先在列表里选要彻底删除的条目")
            return
        if not tkmb.askyesno("彻底删除",
                             "这 %d 条会被真正删掉，之后无法恢复。\n继续吗？" % len(sel),
                             parent=self._trash_win):
            return
        for i in sorted(sel, reverse=True):
            self.trash.pop(i)
        self.save()
        self._fill_trash()

    def trash_empty(self):
        if not self.trash:
            self.status.configure(text="回收站本来就是空的")
            return
        if not tkmb.askyesno("清空回收站",
                             "回收站里的 %d 条会被真正删掉，之后无法恢复。\n继续吗？"
                             % len(self.trash), parent=self._trash_win):
            return
        self.trash = []
        self.save()
        self._fill_trash()
        self.status.configure(text="回收站已清空")

    # ============================================================ 使用帮助

    def open_help(self):
        """使用帮助窗。第一次用的人（比如拷给朋友的电脑）得有个地方能自学。

        做成**可滚动的只读 Text**，不画在画布上：文案有 70 多行，Text 自带
        换行 / 滚动 / 选中复制 —— 别人问「怎么备份」时能直接把那段复制给他。
        只读（state="disabled"）不影响选中和复制，但挡住误改。
        """
        w = self._help_win
        if w is not None and w.winfo_exists():
            w.deiconify()          # 可能被最小化过
            w.lift()
            w.focus_set()
            return w

        w = tk.Toplevel(self.root)
        w.title("使用帮助")
        w.configure(bg=C_BG)
        self._follow_top(w)        # 主窗置顶时它得跟着，否则会被压在后面
        w.minsize(520, 400)
        self._help_win = w
        w.protocol("WM_DELETE_WINDOW", w.destroy)

        head = tk.Frame(w, bg=C_TOP)
        head.pack(fill="x")
        tk.Label(head, text="照着自己的需要看就行，不用一次读完",
                 font=F_SMALL, bg=C_TOP, fg=C_INK3)\
            .pack(side="left", padx=14, pady=9)
        tk.Frame(w, bg=C_LINE, height=1).pack(fill="x")

        body = tk.Frame(w, bg=C_WHITE)
        body.pack(fill="both", expand=True)

        sb = tk.Scrollbar(body, orient="vertical", width=12, troughcolor=C_WHITE,
                          bg="#d9d3c7", activebackground="#c4bdaf",
                          relief="flat", bd=0)
        sb.pack(side="right", fill="y")

        # tabs=(150,) 是给 "k" 那种两列条目对齐用的：左边名字从 18px 起，
        # Tab 跳到 150px，右列再长也会在 166px 处折行对齐。
        txt = tk.Text(body, font=F_BODY, bg=C_WHITE, fg=C_INK, relief="flat", bd=0,
                      wrap="word", padx=18, pady=14, cursor="arrow",
                      highlightthickness=0, spacing1=1, spacing3=4,
                      yscrollcommand=sb.set, tabs=(150,))
        txt.pack(side="left", fill="both", expand=True)
        sb.configure(command=txt.yview)
        self._help_text = txt

        txt.tag_configure("h1", font=F_H1, foreground=C_INK, spacing1=2, spacing3=14)
        txt.tag_configure("h2", font=F_H2, foreground=C_INK, spacing1=16, spacing3=6)
        txt.tag_configure("p",  font=F_BODY, foreground=C_INK2, spacing1=2, spacing3=6)
        txt.tag_configure("n",  font=F_BODY, foreground=C_INK,
                          lmargin1=18, lmargin2=30, spacing3=3)
        txt.tag_configure("k",  font=F_BODY, foreground=C_INK2,
                          lmargin1=18, lmargin2=166, spacing3=3)
        txt.tag_configure("kb", font=F_TINY, foreground=C_INK)

        for sec in HELP_SECTIONS:
            kind = sec[0]
            if kind == "k":
                name, desc = sec[1]          # "k" 带的是 (名字, 解释) 这一对
                txt.insert("end", name, ("k", "kb"))
                txt.insert("end", "\t" + desc + "\n", "k")
            else:
                txt.insert("end", sec[1] + "\n", kind)

        txt.configure(state="disabled")    # 只读，但照样能选中复制
        txt.see("1.0")

        foot = tk.Frame(w, bg=C_TOP)
        foot.pack(fill="x", side="bottom")
        tk.Frame(foot, bg=C_LINE, height=1).pack(fill="x")
        bar = tk.Frame(foot, bg=C_TOP)
        bar.pack(fill="x", padx=14, pady=8)
        tk.Label(bar, text="数据文件：%s" % DATA_FILE, font=F_SMALL,
                 bg=C_TOP, fg=C_INK3, anchor="w").pack(side="left")
        self._btn(bar, "关闭", w.destroy).pack(side="right")
        # 版本号放右边（左边留给数据文件路径，它本来就是这行里最长的）。
        # 打包成 exe 之后，「手上这是哪一版」就只能从这儿看出来了。
        tk.Label(bar, text="v%s%s" % (APP_VERSION, "（打包版）" if FROZEN else ""),
                 font=F_SMALL, bg=C_TOP, fg=C_INK3)\
            .pack(side="right", padx=(0, 12))

        w.bind("<Escape>", lambda e: w.destroy())

        # 弹在右上角：不挡住卡片区，也不跟统计 / 复盘面板叠在同一条竖线上。
        # **必须收一下边**：主窗最大化时它可比屏幕还宽，直接按公式放会把帮助窗
        # 推出屏幕外（右半截看不见）。
        # ★ 收边要用**主窗所在那块显示器**的工作区（screen_areas），不是
        #   winfo_screenwidth —— 那报的是主屏尺寸。主窗在副屏时，按主屏宽度收边
        #   会把帮助窗整个拽回主屏：看着就是「帮助没跟着软件走，跑到另一块屏上」。
        w.update_idletasks()
        rx = self.root.winfo_x() + self.root.winfo_width()
        _full, (wl, wt, wr, wb) = screen_areas(self.root)
        pw, ph = w.winfo_reqwidth(), w.winfo_reqheight()
        px = min(rx - pw - 40, wr - pw - 16)
        py = min(self.root.winfo_y() + 70, wb - ph - 56)
        w.geometry("+%d+%d" % (max(wl + 8, px), max(wt + 8, py)))
        w.focus_set()
        return w

    # ============================================================ 耗时统计面板

    def _period_keys(self, period):
        """这个口径包含哪些日期。返回 None 表示「全部，不做日期过滤」。"""
        T = today()
        if period == "today":
            return {d2s(T)}
        if period == "week":
            mon = T - datetime.timedelta(days=T.weekday())
            return {d2s(mon + datetime.timedelta(days=i))
                    for i in range((T - mon).days + 1)}
        if period == "d7":
            return {d2s(T - datetime.timedelta(days=i)) for i in range(7)}
        return None

    def _secs_of(self, t, keys, now=None):
        """任务在指定日期集合里花了多少秒。计时中的那段按「开始那天」归入。"""
        now = now or now_ts()
        sec = 0.0
        for k, v in (t.get("logs") or {}).items():
            if keys is None or k in keys:
                sec += _norm_num(v)
        st = t.get("timer") or 0
        if st and (keys is None or ts_day(st) in keys):
            sec += max(0.0, now - st)
        return sec

    def _day_totals(self, now=None):
        """按日期汇总所有任务的耗时。正在计时的那一段也要算进来（归入
        开始那天），否则「按天分布」的合计会和上面的「总投入」对不上。"""
        now = now or now_ts()
        day = {}
        for t in self.tasks:
            for k, v in (t.get("logs") or {}).items():
                day[k] = day.get(k, 0.0) + _norm_num(v)
            st = t.get("timer") or 0
            if st:
                k = ts_day(st)
                day[k] = day.get(k, 0.0) + max(0.0, now - st)
        return day

    def open_stats(self):
        w = self._stats_win
        if w is not None and w.winfo_exists():
            w.lift()
            self._render_stats()
